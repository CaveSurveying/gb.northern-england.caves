;cave Notts II
;Title: Notts II-Mainstreamway (Downstream Notts II Sump to Upstream Notts II Sump)

*begin MainStreamway

*export Mainstreamway1.3
*export Mainstreamway2.1
*export Mainstreamway2.12
*export Mainstreamway3.33
*export Mainstreamway3.GITag
*export Mainstreamway3.55	;Tag at Showerbath
*export Mainstreamway4.030	;Tag for climb up into Showerbath Inlet(Note:Not same as Mainstreamway3.55 Tag at Showerbath which is where the water comes in.
*export MainStreamway5.011	;Tag near Count Lazlos / Bruno Kranskis
*export MainStreamway5.019	;Tag at Dome Inlet
*export Mainstreamway7.0	;Curry Junction
*export Mainstreamway7.12	;Start of Inlet 5
*export MainStreamway8.8	;Start of Daylight Aven
*export MainStreamway8.10	;Start of Paaschendale
*export MainStreamway6.013v 	;Oliver Lloyds aven tag


*include MainStreamway1   ; 19/10/2006 Neil, Richard
*include MainStreamway2   ; 16/10/2006 Neil, Richard
*include MainStreamway3   ; 31/01/2007 Neil, Becka
*include MainStreamway4   ; 2/12/00    Ray, 
*include MainStreamway5   ; 7/12/00    Ray, Hugh
*include MainStreamway6   ; 13/01/01   Hugh, Richard
*include Mainstreamway7   ; 2002.04.12 Bill, Allan
*include MainStreamway8   ; 23/05/02   Allan, Gerrish


*equate MainStreamway1.12 MainStreamway2.12
*equate MainStreamway2.1 MainStreamway3.GTTag
*equate MainStreamway3.55 MainStreamway4.024
*equate MainStreamway4.030 MainStreamway5.001
*equate MainStreamway5.019 MainStreamway6.001
*equate Mainstreamway6.036 Mainstreamway7.0
*equate MainStreamway7.12 MainStreamway8.0

*end MainStreamway
