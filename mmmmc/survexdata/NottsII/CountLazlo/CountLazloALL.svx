;cave Notts II
;Title: Notts II - Count Lazlo Stroganoff's Inlet

*begin CountLazloALL

*export LazloStrog1.052 BrunoKranskies1.tag
*export TheCupcake.008

*include LazloStrog1
*include LazloStrog2
*include LazloStrog3
*include LazloStrog4
*include LazloStrog5
*include LazloStrog6
*include LazloStrog7
*include BrunoKranskies1
*include BrunoKranskies2
*include LimboPassage
*include TheCupcake
*Include LazloStrog8

*equate LimboPassage.001 LazloStrog1.039
*equate LazloStrog1.001 LazloStrog2.7
*equate LazloStrog2.29 LazloStrog3.29x
*equate LazloStrog3.1 LazloStrog6.3
*equate LazloStrog4.18 LazloStrog5.18
*equate LazloStrog6.42x LazloStrog5.42
*equate LazloStrog7.p LazloStrog3.spit
*equate LazloStrog1.052 TheCupcake.002
*equate BrunoKranskies1.5 LazloStrog4.5x
*equate BrunoKranskies1.8 BrunoKranskies2.8x
*equate LazloStrog1.007 LazloStrog8.001

*end CountLazloALL

