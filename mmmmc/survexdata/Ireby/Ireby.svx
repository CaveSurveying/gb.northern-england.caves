;Title: Ireby Fell Caverns

; the back surveys from bolton extensions do not connect properly

;Date Created 12/12/2006 by Neil Pacey

;-------------------------------------------------------------------------------------------
;Modifications
;
;21-12-06 Added P.H equate for WellPitchInlets  *equate Wellpitchinlets.218 streamway4.001
;20-06-09 Becka split Glory Holes into Cripple Creek, Ireby2 and Glory Holes

;--------------------------------------------------------------------------------------------
;All Ireby Fell Cavern files

*begin Ireby

*export EntranceTag
*equate EntranceTag DingDongBellPitches.001

;Include DingDongBellPitches
*Include "DingDongBellPitches/DingDongBellPitches"	;Ding-Dong-Bell-Rope Pitches

;Include Bubbles Route File
*include "BubblesRoute/BubblesRoute"			;Bubbles Route

;Include Main Streamway Files
*include "MainStreamway/Streamway"			;Main Streamway

;Include Glory Holes and True Grit Files
*include "GloryHoles/GloryHoles"			;Glory Holes and True Grit

;Include Cripple Creek Files
*include "CrippleCreek/CrippleCreek"			;Cripple Creek

;Include Ireby 2 Files
*include "Ireby2/Ireby2"				;Ireby 2 (Jupiter Cavern to sumps)

;Include WellPitchInlets
*include "WellPitchInlets/AllAboveWellPitch" 		;Aberfan/Cornflake/Adulturers/Adulturers Bypass

;Include Duke Street/Duke Street Digs/Whirlpool
*Include "DukeStreet/DukeStreet"			;Duke Street/Whirlpool/Digs

*include "NorthEastInlet/allneinlet"

;-------------------------------------------------------------------------------------------
;Equate Statements

;Equate Bubbles Route
*equate Bubbles.001 DingDongBellPitches.001			;Start of Bubbles Route
*equate Bubbles.215 streamway.streamwaybubblestagdownstream.bubblestag 		;Bubbles Route Joins Streamway

; Equate top of upper streamway to RRCPC cow tag just upstream of where Bubbles enters streamway
;*equate Streamway.streamwaybubblestagdownstream.tag   Bubbles.215

;Equate Glory Holes and True Grit to Cripple Creek
*equate GloryHoles.GloryHoles2.1 CrippleCreek.GloryHoles1.005	;Where True Grit off from Glory Holes / Cripple Creek

;Equate CrippleCreek to Main Streamway and Ireby2
*equate	CrippleCreek.GloryHoles1.001 Streamway.streamwaybubblestagdownstream.bubblestag 	;Start of Cripple Creek (Glory Holes) in Main Streamway
*equate CrippleCreek.cripplecreekconnect.33 Ireby2.jupitertoescalator.33	;End of Cripple Creek beyond connection in Jupiter Cavern

;Equate Ireby2 to dive line bolt in Main Streamway
*equate Ireby2.jupiter2irebyone.50 DukeStreet.DukeStreet1.073	;Loop closure at diving line anchor Duke Street Ireby I

;Equate Main Streamway Files
*equate Streamway.Streamway1.022 DingDongBellPitches.022

;Equate WellPitchInlets						;Cornflake\Aberfan\Adulterers then to NEInlet
*equate allabovewellpitch.abovewellpitch2.4 Streamway.streamwayuptoduckresurvey.1
*equate DukeStreet.ropepitch.63 allabovewellpitch.adultererropewelllink.2 ; P-hanger on boulder shelf above rope pitch
*equate allabovewellpitch.abovewellpitch2.1 DukeStreet.ropepitch.101	; bit confusing as to which phanger surveys are referring to but this *should* be correct 
*equate allabovewellpitch.abovewellpitch.33 DukeStreet.ropepitch.106	; hopefully the RH phanger by cow tag for dry alternative to Well pitch
*equate DukeStreet.ropepitchredonumbers.1 Streamway.streamwayuptoduckresurvey.1	; p hanger before start of Well pitch
*equate DukeStreet.ropepitchredonumbers.4 allabovewellpitch.abovewellpitch2.8	; cow tag at end of Aberfan

;Equate DukeStreet
;*equate DukeStreet.DukeStreet1.059 Streamway.Streamway4.059	;Start of Duke Street
*equate DukeStreet.whirlpool.41 Ireby2.dukest2tocanal.25

;Equate NEInlet (which connects up to Adulterers) to lower streamway
*equate DukeStreet.ropepitch.49 northeastinlet.neinlet1.49x	;top of boulder slope beyond bottom of Rope pitch before crawl to east inlet
*equate DukeStreet.ropepitchredonumbers.24 northeastinlet.neinlet1.4

*equate allabovewellpitch.abovewellpitch3.12 northeastinlet.neinlet1.12x

 
*end Ireby

; EQUATES REMOVED BY BECKA DEC09

; problems connecting across well pitch
; *equate allabovewellpitch.abovewellpitch2.4 Streamway.Streamway3.024 

; connection partway along the ropepitch survey (with bad calibrated SAP) to tie to the Ray Duffy survey and keep the two in line
; this is at the junction with the dam
;*equate Streamway.Streamway4.021a DukeStreet.ropepitch.42


