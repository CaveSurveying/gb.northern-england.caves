;Cave:	Herbert's Hole - end of Rays survey stn 006 to new downstream limit, not incl.upstream inlets
;Surveyors:	Hugh St.L solo
;Date:	17/10/06
;Instruments:	RRCPC Silva, estimated lengths

*equate her2.001	her.006

*begin	her2

*calibrate compass	+5.37

001	002	02.50	105.0	+12.0	;stn001=start of rolypoly tube
002	003	03.00	035.0	-15.0	;short passage to right at stn002
003	004	03.00	120.0	+15.0
004	005	02.00	-	DOWN	;breakthrough climb down
005	006	04.50	030.0	-05.0	;stn006 beneath 'fridge' block
006	007	03.00	100.0	-30.0	;stn007 junction in new stuff
007	008	06.50	210.0	-15.0	;down to 'poco y poco'
008	009	01.00	115.0	00.0
009	010	03.50	215.0	-35.0
010	011	02.00	270.0	-55.0	;stn011=juction with stream tube
011	012	10.00	220.0	-02.0	;continues 4m+ narrow

*end	her2