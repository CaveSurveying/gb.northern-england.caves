*begin leckfell
*export witchesII.witchesII-7.x	;added 22/03/11RGB


;*include Surface/OLD_LFGPS
*include Surface/leckfellsurfacesurvey

; underground surveys - avg mag decl for 2010 = 3 deg W (please put in correct declination for date in each cave survey)
; true N to grid N correction = -0.33 
*calibrate declination 2.67

;; You can comment out second/third entrance equates to see what the surface closure is like

*include NottsII/NottsII
*equate NottsII.Entrance    leckfellsurfacesurvey.NottsIIEntrance
*equate NottsII.inlet7.Inlet7-14.001 leckfellsurfacesurvey.VoldemortEntranceSWcorner
*equate NottsII.CountLazloALL.TheCupcake.008 leckfellsurfacesurvey.CupcakeEntranceSWcorner

*include LostJohns/LostJohns
*equate LostJohns.EntranceTag       leckfellsurfacesurvey.LostJohnsEntranceTag
*equate LostJohns.BoxheadSurfaceRim leckfellsurfacesurvey.BoxHeadEntranceTube
*equate LostJohns.lylecaverndig2.7 NottsII.CountLazloALL.LostJohnsConnection.1

*include RoughPot/RoughPot
*equate RoughPot.LostJohnsEntranceTag leckfellsurfacesurvey.LostJohnsEntranceTag

;*fix	BAD_LostJohnsBoxheadSurfaceRim	67110.19 78353.90 362.70   ;ev.ss19.022a  ;st015 is surface rim
;*entrance BAD_LostJohnsBoxheadSurfaceRim


; North of NottsII area

*include ShortDrop/ShortDrop
*equate ShortDrop.FencePost  leckfellsurfacesurvey.ShortDropFencePost

*include LongDrop/LongDrop
*equate LongDrop.StylePost	leckfellsurfacesurvey.LongDropStylePost

*include BruntskillPot/BruntskillPot
*equate	BruntskillPot.Entrance	leckfellsurfacesurvey.BruntskillPotEntrance

*include BumblingHole/BumblingHole
*equate	BumblingHole.Entrance	leckfellsurfacesurvey.BumblingHoleEntrance

*include CoalHole/CoalHole
*equate	CoalHole.EntranceLoc leckfellsurfacesurvey.CoalHoleEntrance

*include DeathsHeadHole/DeathsHeadHole
*equate	DeathsHeadHole.FencePostTag	leckfellsurfacesurvey.DeathsHeadHoleFencePostTag

*include EyeHoles/Eyeholes
*equate	EyeHoles.006	leckfellsurfacesurvey.EyeHolesStyle

*include GavelPot/GavelPot
*equate	GavelPot.GavelPotFencePost	leckfellsurfacesurvey.GavelPotFencePost

*include RumblingHole/RumblingHole
*equate	RumblingHole.RumblingBeckTopEntrance leckfellsurfacesurvey.RumblingBeckTopEntrance

*include StartingHandleHole/StartingHandleHole
*equate	StartingHandleHole.001 leckfellsurfacesurvey.StartingHandleHole


; South of NottsII area

*include MarbleSteps/AllMarbleSteps
*equate AllMarbleSteps.EntranceTag leckfellsurfacesurvey.MarbleStepsEntranceTag  

*include LowDouk/LowDouk
*equate LowDouk.EntranceTag leckfellsurfacesurvey.LowDoukEntranceTag

*include Ireby/Ireby
*equate Ireby.EntranceTag   leckfellsurfacesurvey.IrebyEntranceTag

*include NottsPot/NottsPot
*equate NottsPot.EntrancePhanger leckfellsurfacesurvey.NottsPotEntrancePhanger

*include RiftPot/RiftPot
*equate RiftPot.EntranceTag leckfellsurfacesurvey.RiftPotEntranceTag

*equate RiftPot.SoutheastInletConnection Ireby.SoutheastInletConnection

*include LargePot/LargePot
*equate LargePot.EntranceTag leckfellsurfacesurvey.LargePotTag

*equate RiftPot.RiftTowardsMousehole.23 LargePot.Large15.23x

*include LittlePot/LittlePot
*equate LittlePot.EntranceTag leckfellsurfacesurvey.LargePotTag

*include Mohole/Mohole

*include KangoHole/KangoHole  


; Witches Cave and surrounding area (some entrances to be tied in with the rest of the surface survey)

*include WitchesCaveII/WitchesII 
*fix WitchesII.WitchesII-2.001 66214 79777 277 ;entrance GPS by K Wood Sept 2010

*include WitchesCave/WitchesCave
*fix WitchesCave.wit.001 66029.79 80004.53 214.77 
*equate WitchesCave.wit7.001 WitchesII.WitchesII-7.x

*include LeckBeckHead/LeckBeckHead
; *fix LeckBeckHead.001 65938.92 80003.18 212.01	; commented out by Becka 30.10.11 and replaced by equate to LeckBeckHeadWestEast surface survey
*equate LeckBeckHeadWestEast.10 LeckBeckHead.001

*include LeckBeckHead/LeckBeckHeadWestEast
*equate LeckBeckHeadWestEast.18 WitchesCave.Witches1DryCave.18

*end leckfell

