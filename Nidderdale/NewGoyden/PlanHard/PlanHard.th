encoding  utf-8

input PlanHardP.th2
input astronomers/astronomers.th #2024 Astronomer's Resurvey & avens

    
#input PlanHardEe.th2
#input PlanHardE90.th2

equate 18@astro.astronomers 1.69@PlanHard
join astrop@astro.astronomers PlanHardSP3


map PlanHardPlan -title "PlanHard Plan"
 #m1p@astronomers #2024 Astronmers
  #PlanHardSP7 #Old Astronomers
  break
  PlanHardSP1
  PlanHardSP3
  break
  PlanHardSP2
  PlanHardSP8
  break
  PlanHardSP4
  PlanHardSP6
  break
  PlanHardSP5
endmap

#map PlanHardME
  #PlanHardSE1
#endmap

#map PlanHardE90 -proj [elevation 90]
  #PlanHardSE90_1
#endmap

survey PlanHard
centreline

copyright 2016 "GNU GPL"

