encoding  utf-8
source NewGoyden.th
# Change name to the main therion file
##Call global templates
input ..\XTherionFiles\_layouts.mp        #standard settings
input ..\XTherionFiles\_globallayouts.thc #more standard settings, different 'size' cave layouts

#Surveys to output
#-----------------

export map -proj plan -layout local -o ../Output/NewGoydenOutput/NewGoyden.pdf
#Produces plan of cave, on a single sheet

export map -proj extended -layout local -o ../Output/NewGoydenOutput/NewGoydenEe.pdf

#export model -fmt survex -o ../Output/NewGoydenOutput/NewGoydenth.3d
#Survex file showing centre line only

#export model -o ../Output/NewGoydenOutput/NewGoyden.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o ../Output/NewGoydenOutput/_Walls.3d
#Survex file showing walls only

#export model -o ../output/NewGoydenOutput/NewGoyden.kml
#export map -o ../Output/NewGoydenOutput/NewGoyden.kml

select NewGoydenPlan

layout local
copy custom_rigging_topos
copy custom_standard_settings
scale 1 500
symbol-set BCRA
grid off
#legend on
#debug on
#colour map-bg [0 10 80]
#colour map-fg scrap
#colour map-fg altitude
colour map-fg [97 86 38]  #pale yellow
symbol-colour [area] [water] [0 20 80]
symbol-colour [area] [sump]  [0 0 100]
map-header 0 0 ne
#symbol-hide group cave-centreline

##################
endlayout
