encoding  utf-8


input AquamoleP.th2
#input AquamoleEe.th2
#input AquamoleE0.th2

map aquamolePlan -title "Aquamole Plan"
  AquamoleSP2
break
  AquamoleSP1
  #AquamoleSP3 #Removed Because of New North Choke Survey
  AquamoleSP4
  AquamoleSP5
  break
  AquamoleSP6
endmap

#map AquamoleME
  #AquamoleSE1
#endmap

#map AquamoleE0 -proj [elevation 0]
  #AquamoleSE0_1
#endmap


survey Aquamole
centreline
#cs OSGB:SE

copyright 2015 "GNU GPL"

