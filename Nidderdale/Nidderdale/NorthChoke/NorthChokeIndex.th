encoding  utf-8
survey NorthChokeIndex

input NCOxbow/NCOxbow.th
input NorthChoke/NorthChoke.th
input LowerNorthChoke/LowerNorthChoke.th



map NorthChokeIndex -title "NorthChokeIndex"
  NCOxbowPlan
  break 
  NorthChokePlan #@NorthChoke
  break
  LowerNorthChokePlan #@LowerNorthChoke
endmap

#map NorthChokeME
  #NorthChokeSE1
  #NorthChokeSE2
  #NorthChokeSE3
#endmap

#survey NorthChokeIndex

join NorthChokeSP3 LowerNorthChokeSP1 -smooth on

centreline

equate 1.0@NorthChoke 1.0@NCOxbow
equate 1.12@NorthChoke 1.0@LowerNorthChoke


copyright 2018 "GNU GPL"



  date 2018.06.03

  team "Nick Bairstow" notes
  team "Chris Fox" instruments
  team "Chris Fox" dog

  instrument  instruments "Nick Disto "

  explo-date 03.06.18


endcentreline
endsurvey

