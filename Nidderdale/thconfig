encoding  utf-8
source nidderdale.th
# Change name to the main therion file


#Surveys to output
#-----------------

select nidderdalePlan


export map -proj plan -layout local -o output/NidderdaleOutput/nidderdale.pdf
export map -o output/NidderdaleOutput/nidderdale.kml
#export model -fmt survex -o output/NidderdaleOutput/nidderdale.3d
export model  -o output/NidderdaleOutput/nidderdale.lox
#export map -proj plan -o output/NidderdaleOutput/nidderdale_Walls.3d
#Survex file showing walls only

####################layout###################
#############################################

layout local
base-scale 1 200
scale 1 500
symbol-set BCRA
debug station-names
#debug on
#colour map-fg altitude
#colour map-fg scrap
symbol-colour area water [25 50 100]
symbol-colour area sump [50 100 100]

transparency on
grid top
map-header 50 90 nw
symbol-hide group cave-centreline
#endlayout

##code to put border around map##
#--------------------------------
code tex-map
     \framethickness=0.5mm
endlayout
