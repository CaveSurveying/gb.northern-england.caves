encoding  utf-8
survey nidderdale -title "Goyden Cave System<br><it>Nidderdale, North Yorkshire<br>United Kingdom" ###### Use standard deviation 0.02 0.02 .01 on all fixes


input ManchesterHole/ManHole.th

input goyden/Goyden.th
input goyden/CapLeftTunnel/CapLeftTunnel.th
input goyden/mudHall/MudHall.th
input goyden/carterPassage/CarterPassage.th
input goyden/labyrinth/LabyrinthIndex.th
input goyden/Pyridine/Pyridine.th
input goyden/goy3/Goy3.th
input goyden/goyden2/Goyden2.th
input goyden/GargettWay/GargettWay.th
input goyden/GargettWay/BallOfStringPassage/BallOfStringPassage.th
input goyden/pillarPot/PillarPot.th
input goyden/pillarPot/PillarCrawls/PillarCrawls.th
input goyden/churchPot/ChurchPot.th
input goyden/goyden2/OctoberPassage/OctoberPassage.th
input goyden/BackSteps/BackSteps.th
input goyden/QuickWinRift/QuickWinRift.th
input goyden/TimberPassage/TimberPassage.th


##DIGITISED GOYDEN SURVEYS
input goyden/goy3/GoydenDownstreamSumps/GoydenDownstreamSumps.th
input goyden/goy3/GoydenDownstreamSumps/GoydenMainStreamExtension.th
input goyden/OldYear/OldYearSeriesIndex.th.th #need to fix the double extension
input goyden/TurfPassage/TurfPassage.th
input goyden/LimleyInlet/LimleyInlet.th
input goyden/Nurgatory/Nurgatory.th
input goyden/LesserStreamPassage/LesserStreamPassage.th

input NewGoyden/FrogPot/FrogPotIndex.th
input NewGoyden/aquamole/Aquamole.th
input NewGoyden/thropePot/ThropePot.th
input NewGoyden/NewGoyden.th
input NewGoyden/shackletons/Shackletons.th
input NewGoyden/planHard/PlanHard.th
input NewGoyden/NorthChoke/NorthChokeIndex.th
input NewGoyden/NewGoydenDownstreamSumps/NewGoydenDownstreamSumps.th
input NewGoyden/OQP/OQP.th
input NewGoyden/PigskinPot/PigskinPot.th
input NewGoyden/HardyPoolsExtension/HardyPoolsExt.th

input Guscott/GuscottIndex.th

##OTHER CAVES
#input NiddHeads/NIddHeadsIndex.th
input LimleyLeadMine/LimleyLeadMine.th
#input LowEglins/LowEglins.th
#input LofthousePot/LofthousePot.th
#input TomTaylors/TomTaylors.th

##SURFACE OVERLAYS
input Surface/surface1/Surface1.th
input Surface/surface2/Surface2.th
input Surface/QuarrySurface/QuarrySurface.th
input Surface/SurfaceOQP/SurfaceOQP.th
input Surface/SurfaceOverlays/Overlays.th
input Surface/SurfaceOverlays/NidderdaleFixedPoints.th   

####################
#### PLAN JOINS ####
####################
join GoydenSP1 churchPotSP4
join GoydenSP1 PillarPotSP1
join GoydenSP1 MudHallSP1
join GoydenSP1 MudHallSP3
join GoydenSP1 LabyrinthSP1@LabyrinthIndex
join LabyrinthSP4@LabyrinthIndex CarterPassageSP1
join LabyrinthSP1@LabyrinthIndex MudHallSP5
join LabyrinthSP2@LabyrinthIndex CapLeftTunnelSP1
join LabyrinthSP1@LabyrinthIndex PyridinePlan@Pyridine
#join OldYearDigiPlan@OldYearSeriesIndex LabyrinthSP2@LabyrinthIndex 
join TurfPassageP1@TurfPassage churchPotSP3
join GoydenSP1 LimleyInletP1@LimleyInlet
join GoydenSP1  UpperNurgatoryP1@Nurgatory
join GoydenSP1  LowerNurgatoryP1@Nurgatory
join EternalOptomist_s3 LesserStreamPassageP1@LesserStreamPassage

join MudHallSP4 ScaffoldTraversePlan@Pyridine
join PillarPotSP2 CapLeftTunnelSP2
join Goyden2SP1 goy3SP1
join Goyden2SP1 OctoberPassagePlan@OctoberPassage
join Goyden2SP1 GoydenSP1 #join the 2 sumps with presumed connection
join GoydenSP2 BackStepsSP1
join NewGoydenSP5 ThropePotSP1
join NewGoydenSP4 PlanHardSP1
join PlanHardSP4  NewGoydenDownstreamSumpsP@NewGoydenDownstreamSumps
join FrogPotSP3@FrogPotIndex AquamoleSP1
join FrogPotSP3@FrogPotIndex ShackletonsSP1
join AquamoleSP4 ShackletonsSP7
join AquamoleSP2 NorthChokeSP1@NorthChokeIndex
join Surface1SP3 Surface2SP4

##JOINING DIGITISED NEWGOYDENSUMPS.  NOTE: THE SUMP SURVEY IS 3B AT BEST FROM BRIDGEHALL DOWN
##I'VE HAD TO DRASTICALLY ALTER IT BETWEEN SUMP 7 AND NEW GOYDEN TO SOME FORM OF DIVE ERROR
##THAT GETS PROGRESSIVELY WORSE DOWNSTREAM.  ANY MAJOR WARP ERRORS IN FUTURE, CHECK HERE FIRST!

join goy3SP1 GoydenMainStreamExtensionPlan@GoydenMainStreamExtension
join GoydenDownstreamSumpsP@GoydenDownstreamSumps GoydenMainStreamExtensionPlan@GoydenMainStreamExtension
join GoydenDownstreamSumpsP@GoydenDownstreamSumps AquamoleSP6
join GoydenDownstreamSumpsP2@GoydenDownstreamSumps AquamoleSP6
join GoydenDownstreamSumpsP3@GoydenDownstreamSumps NewGoydenSP5
join GoydenDownstreamSumpsP2@GoydenDownstreamSumps GoydenDownstreamSumpsP3@GoydenDownstreamSumps

####################################################
##ADD A SURFACE IMAGE
surface
  cs OSGB:SE
   #bitmap XTherionFiles\OSM673x1929.png [241 1572 09976 76120  285 1880 10013 76401] 
   bitmap XTherionFiles\OSM673x1929.png [241 1572 09976 76120  285 1880 10005 76400] #using Nick's trimble correctionm for Man 29/09/24
  
   
##8 digits, 1-2 are pixels of Goyden, 3-4 actual, 5-6 pixels of Manchester, 7-8 actual
endsurface

####################################################

map SurfacePlan  
  OverlaysPlan@Overlays                 ##hydological assumed / proved connection lines  
  GoydenSystem@NidderdaleFixedPoints   ##all entrance GPS (NEEDS AN UPDATE)  
endmap

map NidderdalePlan -title "Goyden Cave System<br><it>Nidderdale, North Yorkshire<br>United Kingdom"  
  #LimleyLeadMinePlan@LimleyLeadMine
  OldQuarryPotPlan@OQP                  ##NEED NEW GPS
  PigskinPotPlan@PigskinPot             ##NEED NEW GPS
  break  
  GuscottIndex@GuscottIndex
  TurfPassagePlan@TurfPassage
  break
  churchPotPlan
  GargettwayPlan
  BallOfStringPassagePlan@BallOfStringPassage
  MudHallPlan
  BackStepsPlan
  PillarPotPlan
  break
  PillarCrawlsPlan@PillarCrawls
  QuickWinRift2@QuickWinRift 
  break
  goydenPlan
  break
  QuickWinRift3@QuickWinRift 
  break
  QuickWinRift1@QuickWinRift
  break
  manholePlan
  EternalOptomist-offset [-50 10 m] below
  break
  LesserStreamPassagePlan@LesserStreamPassage  [-40 0 m] below  
  PyridineP@Pyridine
  LabyrinthIndex@LabyrinthIndex
  CarterPassagePlan
  goyden2Plan
  OctoberPassageP@OctoberPassage
  goy3Plan
  CapLeftTunnelPlan
  TimberPassagePlan@TimberPassage
  break
  OldYearSeriesIndex@OldYearSeriesIndex
  break
  LimleyInletPlan@LimleyInlet
  NurgatoryPlan@Nurgatory   
  break

  
  
  ####NewGoyden/Frog####
  ThropePotPlan
  AstronomersPlan@astronomers
  PlanHardPlan
  break
  NewGoydenPlan
  break
  FrogPotIndex@FrogPotIndex
  break
  NorthChokeIndex@NorthChokeIndex
  ShackletonsPlan
  aquamolePlan  
  break
  GoydenDownstreamSumpsPlan@GoydenDownstreamSumps
  GoydenMainStreamExtPlan@GoydenMainStreamExtension
  NewGoydenDownstreamSumpsPlan@NewGoydenDownstreamSumps  
  HardyPoolsExtPlan@HardyPoolsExt
  
  #NiddHeadsIndexPlan@NiddHeads
  
  ############################
  #LimleyLeadMinePlan@LimleyLeadMine  #digitised.  adding creates large pdf as this is ~1km of passage heading west
  #LowEglinsPlan
  #LofthousePotPlan   
  #TomTaylors@TomTaylors ##This is the new cave that needed the 
                        ##survey endsurvey to render correctly.
                        ##It is a Small cave located in bottom left of pdf
                        ##Adding this has buggered up the current pdf layout
                        ##so that needs sorting.

  
endmap

################################
## Chris Fox Publication Maps ##
################################
map PublishSection1 -title "Manchester Hole to Goyden Pot<br><it>Nidderdale, North Yorkshire<br>United Kingdom"
  TurfPassagePlan@TurfPassage
  break
  churchPotPlan
  GargettwayPlan
  BallOfStringPassagePlan@BallOfStringPassage
  MudHallPlan
  BackStepsPlan
  PillarPotPlan
  break
  PillarCrawlsPlan@PillarCrawls
  break
  QuickWinRift2@QuickWinRift 
  break
  goydenPlan
  break
  QuickWinRift3@QuickWinRift 
  break
  QuickWinRift1@QuickWinRift
  break
  manholePlan
  EternalOptomist-offset [-40 0 m] below
  break
  LesserStreamPassagePlan@LesserStreamPassage  [-40 0 m] below  
  LabyrinthSection1@LabyrinthIndex
  PyridineP@Pyridine
  CarterPassagePlan
  #goyden2Plan
  #OctoberPassageP@OctoberPassage
  #goy3Plan
  CapLeftTunnelPlan
  TimberPassagePlan@TimberPassage
  break
  OldYearSeriesIndex@OldYearSeriesIndex
  break
  LimleyInletPlan@LimleyInlet
  NurgatoryPlan@Nurgatory
  break
  LesserStreamPassagePlan@LesserStreamPassage
  QuickWinRiftPlan@QuickWinRift  
endmap

map PublishSection2 -title "New Goyden Pot<br><it>Nidderdale, North Yorkshire<br>United Kingdom"
  #Section2@Overlays  
  Section2@NidderdaleFixedPoints
  break
  NewGoydenFaults@Overlays
  break
  ThropePotPlan
  break
  AstronomersPlan@astronomers
  break
  PlanHardPlan  
  break
  NewGoydenPlan
  break
  FrogPotIndex@FrogPotIndex
  break
  NorthChokeIndex@NorthChokeIndex
  ShackletonsPlan
  aquamolePlan  
  break
  GoydenDownstreamSumpsPlan@GoydenDownstreamSumps
  HardyPoolsExtPlan@HardyPoolsExt
endmap

map PublishSection3 -title "Goyden System - The Missing Links<br><it>Nidderdale, North Yorkshire<br>United Kingdom"
  #Section3@Overlays
  GoydenMainStreamExtPlan@GoydenMainStreamExtension
  GoydenDownstreamSumpsSection3@GoydenDownstreamSumps
  LabyrinthSection3@LabyrinthIndex
  OctoberPassageP@OctoberPassage
  goyden2Plan
  goy3Plan
  GuscottIndex@GuscottIndex
  FrogPotSection3@FrogPotIndex
  #FrogPotIndex@FrogPotIndex
  break
  NorthChokeSection3@NorthChokeIndex
endmap
###############################################
###############################################


centerline
equate 1.12@Goyden 7.36@ManHole
equate 1.16@Goyden 1.21@ChurchPot
equate 1.8@Goyden 1.0@MudHall
equate 1.11@Goyden 1.70@MudHall
equate 1.8@Goyden 1.0@PillarPot
equate 1.19@Goyden 1.19@Labyrinth.LabyrinthIndex
equate 1.82@Labyrinth.LabyrinthIndex 1.0@CarterPassage 
equate 1.23@Labyrinth.LabyrinthIndex 1.101@MudHall
equate 1.41@Labyrinth.LabyrinthIndex 1.0@CapLeftTunnel
equate 1.39@Labyrinth.LabyrinthIndex 0@Pyridine
equate 1.10@AJunction.LabyrinthIndex 11@Pyridine
equate 8.1@Goyden 1.0@BackSteps
equate 1.42@Labyrinth.LabyrinthIndex 0@OldYearDigi.OldYearSeriesIndex 
equate 0@TurfPassage 1.27@ChurchPot
equate 1.19@Goyden 1.19@LimleyInlet 
equate 1.14@Goyden 1.14@Nurgatory
equate 1.7@Goyden 1.7@QuickWinRift
equate 1.4@PillarPot 1.29@CapLeftTunnel 
equate 1.21@PillarPot 1.21@PillarCrawls
equate 1.10@PillarPot 1.10@TimberPassage 

equate 7.24@ManHole 20@LesserStreamPassage

equate 1.0@GargettWay 1.9@ChurchPot
equate 1.5@GargettWay 1.17@BallOfStringPassage
equate  1.16@GargettWay 1.16@Goyden2
equate 1.17@Goyden2 0@OctoberPassage 
equate 1.28@Goyden2 4.0@goy3
equate 1.9@goy3 1.9@GoydenMainStreamExtension
equate 11@GoydenMainStreamExtension 24@GoydenDownstreamSumps
equate 1.69@GoydenDownstreamSumps 1.69@Aquamole
#equate 1.36@GoydenDownstreamSumps 1.36@NewGoyden
#equate 1.36@GoydenDownstreamSumps 1.9@goy3

equate 5.47@NewGoyden 1.28@FrogPot.FrogPotIndex
equate 1.15@NewGoyden 1.0@PlanHard
equate 1.22@NewGoyden 1.0@ThropePot
equate 0@HardyPoolsExt 1.29@PlanHard
equate 1.19@FrogPot.FrogPotIndex 1.19@Aquamole
equate 1.28@FrogPot.FrogPotIndex 1.0@Shackletons
equate 1.40@Aquamole 1.0@NorthChoke.NorthChokeIndex
equate 1.51@Aquamole 1.57@Shackletons
equate 1.59@NewGoydenDownstreamSumps 1.59@PlanHard

equate 1.34@ThropePot 1.50@Surface1
equate 1.53@Surface1 1.0@NewGoyden
equate 1.44@Surface2 1.0@NewGoyden
equate 100@QuarrySurface 1.0@NewGoyden
equate 1.0@Surface2 1.0@Surface1
equate 1.13@Surface2 1.47@Guscott.GuscottIndex 
equate 1.26@Surface2 6.0@FrogPot.FrogPotIndex
equate 1@SurfaceOQP 0@OQP


equate S1@Overlays 1.10@CarterPassage 
equate S2@Overlays 10@NewGoydenDownstreamSumps
equate 0@Overlays 1.0@NewGoyden


endcenterline

endsurvey

