encoding  utf-8
survey nidderdale -title "Goyden Cave System<br><it>Nidderdale, North Yorkshire<br>United Kingdom" ###### Use standard deviation 0.02 0.02 .01 on all fixes

input goyden/Goyden.th
input manhole/ManHole.th
input pillarPot/PillarPot.th
input FrogPot/FrogPotIndex.th
input aquamole/Aquamole.th
input Guscott/GuscottIndex.th
input churchPot/ChurchPot.th
input gargettWay/GargettWay.th
input goyden2/Goyden2.th
input labyrinth/LabyrinthIndex.th
input mudHall/MudHall.th
input carterPassage/CarterPassage.th
input thropePot/ThropePot.th
input newGoyden/NewGoyden.th
input shackletons/Shackletons.th
input planHard/PlanHard.th
input surface1/Surface1.th
input surface2/Surface2.th
input QuarrySurface/QuarrySurface.th
input goy3/Goy3.th
input NorthChoke/NorthChokeIndex.th
input CapLeftTunnel/CapLeftTunnel.th
#input LowEglins/LowEglins.th
#input LofthousePot/LofthousePot.th
#input TomTaylors/TomTaylors.th

##PW NEW 2024

input goy3/GoydenDownstreamSumps/GoydenDownstreamSumps.th
input NewGoyden/NewGoydenDownstreamSumps/NewGoydenDownstreamSumps.th
input goyden/Pyradine/pyradine.th

input OQP/OQP.th
input PigskinPot/PigskinPot.th
input SurfaceOQP/SurfaceOQP.th
input SurfaceOverlays/Overlays.th
#input LimleyLeadMine/LimleyLeadMine.th


#### Plan Joins ####

join GoydenSP1 LabyrinthSP1@LabyrinthIndex
join churchPotSP4 GoydenSP1
join GoydenSP1 PillarPotSP1
join GoydenSP1 MudHallSP1
join GoydenSP1 MudHallSP3
join FrogPotSP3@FrogPotIndex AquamoleSP1
join FrogPotSP3@FrogPotIndex ShackletonsSP1
join AquamoleSP4 ShackletonsSP7
join AquamoleSP2 NorthChokeSP1@NorthChokeIndex
join LabyrinthSP4@LabyrinthIndex CarterPassageSP1
join LabyrinthSP1@LabyrinthIndex MudHallSP5
join NewGoydenSP4 PlanHardSP1
join ThropePotSP1 NewGoydenSP5
join Surface1SP3 Surface2SP4
join Goyden2SP1 goy3SP1
join CapLeftTunnelSP1 LabyrinthSP2@LabyrinthIndex
join CapLeftTunnelSP2 PillarPotSP2
join PlanHardSP4  NewGoydenDownstreamSumpsP@NewGoydenDownstreamSumps
join Goyden2SP1 GoydenSP1 #join the 2 sumps with presumed connection

join LabyrinthSP1@LabyrinthIndex pyradine-PyradinePlanp@pyradine
join MudHallSP4 pyradine-ScaffoldTraverswp@pyradine


#join PlanHardSP2  NewGoydenSP4

##JOINING DIGITISED NEWGOYDENSUMPS.  NOTE: THE SUMP SURVEY IS 3B AT BEST
##I'VE HAD TO DRASTICALLY ALTER IT TO FIT WITH THE KNOWN CAVE.  SOME FORM OF DIVE ERROR
##THAT GETS PROGRESSIVELY WORSE DOWNSTREAM

join GoydenDownstreamSumpsP@GoydenDownstreamSumps goy3SP1
join GoydenDownstreamSumpsP@GoydenDownstreamSumps AquamoleSP6

####################################################


map surfacePlan  
  Surface2Plan
  surface1Plan
  #m1p@SurfaceOQP #need latest GPS from Nick, but does not really work as surface overlay
  break
  m1p@Overlays
endmap

map nidderdalePlan -title "Goyden Cave System<br><it>Nidderdale, North Yorkshire<br>United Kingdom"  
  m1p@OQP   #NEED NEW GPS
  m1p@PigskinPot #NEED NEW GPS
  break  
  GuscottIndex@GuscottIndex
  churchPotPlan
  gargettwayPlan
  MudHallPlan
  PillarPotPlan
  break
  goydenPlan
  break
  manholePlan
  EternalOptomist-offset [-50 0 m] below
  m1p@pyradine
  LabyrinthIndex@LabyrinthIndex
  CarterPassagePlan
  goyden2Plan
  goy3Plan
  CapLeftTunnelPlan
  
  ####NewGoyden/Frog####
  QuarrySurfacePlan
  ThropePotPlan
  m1p@astronomers
  PlanHardPlan
  break
  NewGoydenPlan
  break
  #frogpotPlan
  FrogPotIndex@FrogPotIndex
  break
  NorthChokeIndex@NorthChokeIndex
  ShackletonsPlan
  aquamolePlan  
  break
  m1p@GoydenDownstreamSumps
  m1p@NewGoydenDownstreamSumps  
  
  ############################
  #m1p@LimleyLeadMine  #digitised.  adding creates large pdf as this is ~1km of passage heading west
  #LowEglinsPlan
  #LofthousePotPlan   
  #TomTaylors@TomTaylors ##This is the new cave that needed the 
                        ##survey endsurvey to render correctly.
                        ##It is a Small cave located in bottom left of pdf
                        ##Adding this has buggered up the current pdf layout
                        ##so that needs sorting.

  
endmap

################################
## Chris Fox Publication Maps ##
################################

map PublishSection1 -title "Manchester Hole to Goyden Pot<br><it>Nidderdale, North Yorkshire<br>United Kingdom"
churchPotPlan
  gargettwayPlan
  MudHallPlan
  PillarPotPlan
  break
  goydenPlan
  break
  manholePlan
  EternalOptomist-offset [-50 0 m] below  
  LabyrinthSection1@LabyrinthIndex
  m1p@pyradine
  CarterPassagePlan
  #goyden2Plan
  #goy3Plan
  CapLeftTunnelPlan
endmap

map PublishSection2 -title "New Goyden Pot<br><it>Nidderdale, North Yorkshire<br>United Kingdom"
  ThropePotPlan
  m1p@astronomers
  PlanHardPlan
  break
  NewGoydenPlan
  break
  #frogpotPlan
  FrogPotIndex@FrogPotIndex
  break
  NorthChokeIndex@NorthChokeIndex
  ShackletonsPlan
  aquamolePlan
endmap

#map PublishSection3 -title "Everything Else?<br><it>Nidderdale, North Yorkshire<br>United Kingdom"


#endmap


###############################################
###############################################


centerline
equate 1.41@Labyrinth.LabyrinthIndex 1.0@CapLeftTunnel
equate 1.10@AJunction.LabyrinthIndex 11@pyradine
equate 1.4@PillarPot 1.29@CapLeftTunnel 
equate 1.12@Goyden 7.36@ManHole 
equate 1.16@Goyden 1.21@ChurchPot
equate 1.8@Goyden 1.0@MudHall
equate 1.11@Goyden 1.70@MudHall
equate 1.23@Labyrinth.LabyrinthIndex 1.101@MudHall
equate 1.0@GargettWay 1.9@ChurchPot
equate 1.16@Goyden2 1.16@GargettWay
equate 1.19@Labyrinth.LabyrinthIndex 1.19@Goyden
equate 1.8@Goyden 1.0@PillarPot
equate 1.0@CarterPassage 1.82@Labyrinth.LabyrinthIndex
equate 1.19@FrogPot.FrogPotIndex 1.19@Aquamole
equate 1.28@FrogPot.FrogPotIndex 1.0@Shackletons
equate 1.40@Aquamole 1.0@NorthChoke.NorthChokeIndex
equate 1.51@Aquamole 1.57@Shackletons
equate 5.47@NewGoyden 1.28@FrogPot.FrogPotIndex
equate 1.15@NewGoyden 1.0@PlanHard
equate 1.22@NewGoyden 1.0@ThropePot

equate 1.28@Goyden2 4.0@goy3

equate 1.34@ThropePot 1.50@Surface1
equate 1.53@Surface1 1.0@NewGoyden
equate 1.44@Surface2 1.0@NewGoyden
equate 100@QuarrySurface 1.0@NewGoyden
equate 1.0@Surface2 1.0@Surface1
equate 1.13@Surface2 1.47@Guscott.GuscottIndex 
equate 1.26@Surface2 6.0@FrogPot.FrogPotIndex

equate 1.59@NewGoydenDownstreamSumps 1.59@PlanHard
equate 1@SurfaceOQP 0@OQP

equate 0@pyradine 1.39@Labyrinth.LabyrinthIndex

##PW IN PROGRESS - AS GoyDownSump are digitised need to fudge some data to prevent warp.
#equate 1.36@GoydenDownstreamSumps 1.36@NewGoyden
equate 1.69@GoydenDownstreamSumps 1.69@Aquamole
#equate 1.36@GoydenDownstreamSumps 1.9@goy3

equate 1.10@CarterPassage S1@Overlays
equate 10@NewGoydenDownstreamSumps S2@Overlays


endcenterline

endsurvey

