encoding  utf-8

input Goy3P.th2
#input Sump2/Sump2.th
#input Goy3Ee.th2
#input Goy3E90.th2

map goy3Plan -title "Goyden 3 Plan"
  goy3SP1
  #Sump2Plan@Sump2
endmap

#map goy3ME
  #goy3SE1
#endmap

#map goy3E90 -proj [elevation 90]
  #goy3SE90_1
#endmap

survey goy3
centreline

#equate 4.0@Sump2 1.0@Goy3

