encoding  utf-8


input BRCanalPlan.th2
input BRCanalEe.th2

map BRCanalPlan  -title "Beet Root Canal Plan"
  BRCanalSP1
endmap

map BRCanalEe -title "BRCanal Extended Elevation"
  BRCanalSE1
endmap

survey BRCanal
centreline

