encoding  utf-8


input Lab2Plan.th2
#input Lab2Ee.th2
#input Lab2E90.th2

map Lab2Plan -title "Labyrinth 2"
  Lab2SP3
  break
  Lab2SP2
  break
  Lab2SP1
  #Lab2SP4 ##hiding, so that digitised Lab can be used
    
endmap

#map Lab2ME
  #Lab2SE1
  #Lab2SE2
  #Lab2SE3
  #Lab2SE4
#endmap

survey Lab2
#centreline



centreline

equate 9.2 10.2
#equate 1.3 7.3 Turned off because of big error

