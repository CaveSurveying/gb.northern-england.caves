encoding  utf-8
survey LabyrinthIndex

input Labyrinth/Labyrinth.th
input Lab2/Lab2.th
input BeetRoot/BeetRoot.th
input BRCanal/BRCanal.th
input BeetRootSump/BeetRootSump.th
input AJunction/AJunction.th
input WormDrive/WormDrive.th ##digitised version
input LabyrinthDigitised/LabyrinthDigitised.th

map LabyrinthIndex -title "Labyrinth Index"
  LabyrinthPlan
  break
  AJunctionPlan
  Lab2Plan
  break
  WormDrivePlan@WormDrive  
  break
  BeetRootPlan
  break
  LabyrinthDigitisedPlan@LabyrinthDigitised  
  break  
  BRCanalPlan
  BeetRootSumpPlan
endmap

map LabyrinthSection1 -title "Labyrinth Section 1" #used for Chris' Publication Section 1
  LabyrinthPlan
  AJunctionPlan
  #Lab2Plan 
  break
  WormDrivePlan@WormDrive
  break
  LabyrinthDigitisedPlan@LabyrinthDigitised
endmap

map LabyrinthSection3 -title "Labyrinth Section 3" #used for Chris' Publication Section 1
  BRCanalPlan
  BeetRootSumpPlan
endmap


map LabyrinthEeIndex -title "Sand Tunnel To Beet Root Ee"
#BRCanalSE1
#BeetRootSE1
#BeetRootSE2
#BeetRootSE3
#BeetRootSE4
BRCanalEe
BeetRootEe
endmap

join LabyrinthSP2 Lab2SP1
join Lab2SP3 BeetRootSP1
join BRSP4End BRCSP1Start
join BRSP5Start BRCSP1End
join LabyrinthSP1 AJunctionSP1
#join Line2@Labyrinth Line1@AJunction
#join Line4@Labyrinth:0 Line3@AJunctionend
join Lab2SP3 WormDriveP1@WormDrive 

#join LabyrinthSP1 LabyrinthDigitisedP2@LabyrinthDigitised
#join Lab2SP3 LabyrinthDigitisedP2@LabyrinthDigitised


centreline

equate 1.47@Labyrinth 1.0@Lab2 
equate 1.3@Lab2 7.5@Lab2
equate 1.31@Lab2 1.0@BeetRoot
equate 1.18@BeetRoot 1.8@BRCanal
equate 0@BeetRootSump 1.0@BRCanal
equate 1.0@AJunction 1.33@Labyrinth
equate 102.6@AJunction 1.26@Labyrinth
equate 1.18@Lab2 1.18@WormDrive
equate 1.32@Labyrinth 1.32@LabyrinthDigitised

copyright 2018 "GNU GPL"



  date 2018.08.20 


  explo-date 20.08.18


endcentreline
endsurvey

