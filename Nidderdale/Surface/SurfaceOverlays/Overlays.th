encoding  utf-8
survey Overlays -title "Overlays"

input PresumedConnectionsPlan.th2
input NewGoydenFaults.th2

map OverlaysPlan -title "Overlays"
  #PresumedConnectionsPlan
  GoydenPlan
  NewGoydenPlan
  OtherPlan
  NewGoydenFaultsPlan
endmap

map Section2 -title "Section 2 for Chris Fox Publications"
  NewGoydenPlan
  NewGoydenFaultsPlan
endmap

map Section3 -title "Section 3 for Chris Fox Publications"
  GoydenPlan
  #NewGoydenPlan  
  
endmap

map NewGoydenFaults -title "New Goyden Faults"
## Fault Lines
  NewGoydenFaultsPlan
endmap



centerline
  flags surface
    
    date 2024.03.11 
   # team "Phil Walker"

    units length meters
    units compass clino degrees
    data normal from to length compass clino
    

   #S1 S2 0 0 0
   #P1 P2 0 0 0 
    
  endcenterline

endsurvey

