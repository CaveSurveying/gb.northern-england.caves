encoding  utf-8


input FrogPotP.th2
#input FrogPotEe.th2

map frogpotPlan -title "Frog Pot Plan"
  FrogPotSP1
  break
  FrogPotSP2
  break
  FrogPotSP3
endmap

#map FrogPotME
  #FrogPotSE1
#endmap


survey FrogPot
 centreline
 cs OSGB:SE
 #declination -1.4 degrees


copyright 2015 "GNU GPL"

