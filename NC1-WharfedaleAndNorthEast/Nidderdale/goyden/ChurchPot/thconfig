encoding  utf-8
source ChurchPot.th
# Change name to the main therion file
input ..\..\XTherionFiles\_layouts.mp        #standard settings
input ..\..\XTherionFiles\_globallayouts.thc #more standard settings, different 'size' cave layouts


#Surveys to output
#-----------------

export map -proj plan -layout local -o ChurchPot.pdf
#Produces plan of cave, on a single sheet

export map -proj extended -layout riggingTopo -o ChurchPotEe.pdf


#Survex file showing centre line only

#export model -o ChurchPot.lox
#3d therion model to be viewed in the therion viewer

#export map -proj plan -o ChurchPot/_Walls.3d
#Survex file showing walls only

#export model -o ChurchPot.kml
export map -layout local -o ChurchPot.kml

layout local
#scale 1 100
symbol-set BCRA
debug off
#colour map-bg
#colour map-fg elevation
#symbol-colour [area] [water-flow] [0 20 0]
map-header 0 0 ne
#symbol-hide group cave-centreline
endlayout

layout riggingTopo

copy custom_rigging_topos
copy custom_standard_settings
copy custom_scalebar
scale-bar 25 m
map-comment "Rigging Guide<br><br>Black Sheep Diggers<br><br>BCRA Grade 5D (except where stated)<br>Data: cave-registry.org.uk/svn/NorthernEngland/Nidderdale"
scale 1 500
grid off
colour map-fg [97 86 38]  #pale yellow
endlayout
