encoding  utf-8
source GlasfurdsIndex.th

#surveys to output#
#-----------------#

select GlasfurdsUpStreamExt1.GlasfurdsIndex
select GlasfurdsUpStreamExt2.GlasfurdsIndex
select Glasfurds.GlasfurdsIndex
select GlasfurdsLink.GlasfurdsIndex



export map -proj plan -layout local -o Output/GlasfurdsIndex.pdf
