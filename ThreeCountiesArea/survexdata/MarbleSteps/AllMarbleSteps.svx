;Cave:	Marble Steps Area

; made from 3 distinct caves, hence called AllMarbleSteps, but could be renamed to MarbleStepsArea instead
; Caves are Marble Steps Pot (3 entrances) and ????

*begin	AllMarbleSteps
*export EntranceTag 
*export surfacemarblesteps.001

*entrance StepsPotEntrance
*entrance WetRouteEntrance
*entrance LostMarblesEntrance

*equate EntranceTag SurfaceMarbleSteps.001
*equate StepsPotEntrance StepsPot.StepsPot1.015
*equate WetRouteEntrance WetRoute.WetRoute1.001
*equate LostMarblesEntrance LostMarbles.LostMarbles1.001

*include "SurfaceMarbleSteps/SurfaceMarbleSteps"
*include "SurfaceMarbleSteps/SurfaceMarbleSteps2Sink"
;*include "MarbleStepsPot/MarbleStepsPot"
*include "StepsPot/StepsPot"
*include "LostMarbles/LostMarbles"
*include "WetRoute/WetRoute"
*include "MainChamber/MainChamber"
*include Intestines1
*include Intestines2
*include Intestines3
*include TwigSeries

;--------------------------------------------------------------------

;*equate SurfaceMarbleSteps.001	MarbleStepsPot.Mas01.001
*equate SurfaceMarbleSteps.007	SurfaceMarbleSteps2Sink.001

;*equate	MarbleStepsPot.Mas01.003	MarbleStepsPot.Mas02.001
;*equate	MarbleStepsPot.Mas02.016	MarbleStepsPot.Mas03.001

*equate StepsPot.StepsPot1.001 StepsPot.StepsPot2.008 
*equate StepsPot.StepsPot1.015 SurfaceMarbleSteps.003 
*equate LostMarbles.LostMarbles1.001 SurfaceMarbleSteps.008 
*equate LostMarbles.LostMarbles1.019 LostMarbles.LostMarbles2.001 
*equate LostMarbles.LostMarbles2.022 LostMarbles.LostMarbles3.001
*equate WetRoute.WetRoute1.001 SurfaceMarbleSteps.007
*equate MainChamber.MainChamber1.026x WetRoute.WetRoute1.026
*equate MainChamber.Mainchamber2.001 WetRoute.Sidewinder1.010

*equate WetRoute.sidewinder1.008 Mainchamber.Mainchamber1.006
*equate WetRoute.sidewinder1.009 Mainchamber.Mainchamber1.005
*equate WetRoute.sidewinder1.011 Mainchamber.Mainchamber1.026
*equate WetRoute.sidewinder1.012 Mainchamber.Mainchamber1.029

*equate MainChamber.Mainchamber1.011 LostMarbles.LostMarbles4.1
*equate Intestines1.42x MainChamber.Mainchamber1.042
*equate Intestines2.36x Intestines1.36
*equate Intestines2.43x Intestines1.43
*equate Intestines2.53 Intestines3.1

*equate MainChamber.MainChamber1.009	TwigSeries.1.0

*end	AllMarbleSteps
