*begin leckfell

*cs out OSGB:SD
*cs OSGB:SD

;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;This automatically applies correction for magnetic declination and grid north to all included surveys
*declination auto 67101  77807  373  ; Coordinates for Notts Pot
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

;*export witchesII.witchesII-7.x	;added 22/03/11RGB

;*include Surface/OLD_LFGPS
*include Surface/leckfellsurfacesurvey
*include Surface/largetonorthendpotsurface
*include Surface/shortdroprumblingcoalholebyronsurface
*include Surface/threecountiesgpskdixon2012

; underground surveys - avg mag decl for 2010 = 3 deg W (please put in correct declination for date in each cave survey)
; true N to grid N correction = -0.33 
*calibrate declination 2.67

;; You can comment out second/third entrance equates to see what the surface closure is like

*include NottsII/NottsII
*equate NottsII.Entrance    leckfellsurfacesurvey.NottsIIEntrance
*equate NottsII.inlet7.Inlet7-14.001 leckfellsurfacesurvey.VoldemortEntranceSWcorner
*equate NottsII.CountLazloALL.TheCupcake.008 leckfellsurfacesurvey.CupcakeEntranceSWcorner

*include LostJohns/LostJohns
*equate LostJohns.EntranceTag       leckfellsurfacesurvey.LostJohnsEntranceTag
*equate LostJohns.BoxheadSurfaceRim leckfellsurfacesurvey.BoxHeadEntranceTube
*equate LostJohns.notts2nearconnection.1-0 NottsII.CountLazloALL.BrunoKranskiesBoxheadConnection.50
*equate LostJohns.ljmainstreamway1.74x DeathsHeadHole.DeathsHead_3LJSump.74

*include RoughPot/RoughPot
*equate RoughPot.LostJohnsEntranceTag leckfellsurfacesurvey.LostJohnsEntranceTag

;*fix	BAD_LostJohnsBoxheadSurfaceRim	67110.19 78353.90 362.70   ;ev.ss19.022a  ;st015 is surface rim
;*entrance BAD_LostJohnsBoxheadSurfaceRim


; North of NottsII area

*include ShortDrop/ShortDrop
;*equate ShortDrop.FencePost  leckfellsurfacesurvey.
*equate	ShortDrop.FencePost shortdroprumblingcoalholebyronsurface.0

*include LongDrop/LongDrop
;*equate LongDrop.StylePost	leckfellsurfacesurvey.LongDropStylePost
*equate	LongDrop.StylePost shortdroprumblingcoalholebyronsurface.16

*include BigMeanie/BigMeanie
*equate BigMeanie.BigMeanieDeathsHeadSurface.8 DeathsHeadHole.DeathsHead_1.FencePostTag
*equate BigMeanie.BigMeanie_2.2x DeathsHeadHole.DeathsHead_2.2

*include BruntskillPot/BruntskillPot
*equate	BruntskillPot.Entrance	leckfellsurfacesurvey.BruntskillPotEntrance

*include BumblingHole/BumblingHole
*equate	BumblingHole.Entrance	leckfellsurfacesurvey.BumblingHoleEntrance

*include CoalHole/CoalHole
;*equate	CoalHole.EntranceLoc leckfellsurfacesurvey.CoalHoleEntrance
*equate	CoalHole.029 ShortDrop.shortdrop4canalinlet.14
*equate	CoalHole.EntranceLoc shortdroprumblingcoalholebyronsurface.7

*include DeathsHeadHole/DeathsHeadHole
*equate	DeathsHeadHole.DeathsHead_1.FencePostTag	leckfellsurfacesurvey.DeathsHeadHoleFencePostTag

*include EyeHoles/Eyeholes
*equate	EyeHoles.006	leckfellsurfacesurvey.EyeHolesStyle

*include GavelPot/GavelPot
*equate	GavelPot.GavelPotFencePost	leckfellsurfacesurvey.GavelPotFencePost

*include RumblingHole/RumblingHole
; *equate	RumblingHole.RumblingBeckTopEntrance leckfellsurfacesurvey.RumblingBeckTopEntrance
*equate	RumblingHole.RumblingSurface.1 shortdroprumblingcoalholebyronsurface.10

*include ByronPot/Byron
*equate	Byron.14x shortdroprumblingcoalholebyronsurface.14

*include StartingHandleHole/StartingHandleHole
*equate	StartingHandleHole.001 leckfellsurfacesurvey.StartingHandleHole


; South of NottsII area

*include MarbleSteps/AllMarbleSteps
*equate AllMarbleSteps.EntranceTag leckfellsurfacesurvey.MarbleStepsEntranceTag  

*include LowDouk/LowDouk
*equate LowDouk.EntranceTag leckfellsurfacesurvey.LowDoukEntranceTag

*include Ireby/Ireby
*equate Ireby.EntranceTag   leckfellsurfacesurvey.IrebyEntranceTag

*include NottsPot/NottsPot
*equate NottsPot.EntrancePhanger leckfellsurfacesurvey.NottsPotEntrancePhanger
*equate NottsPot.EntrancePhanger 3cgps.033

*include RiftPot/RiftPot
*equate RiftPot.EntranceTag leckfellsurfacesurvey.RiftPotEntranceTag

*equate RiftPot.SoutheastInletConnection Ireby.SoutheastInletConnection

*equate RiftPot.Rift-LowDoukConnection LowDouk.LowDouk-RiftConnection

*include LargePot/LargePot
*equate LargePot.EntranceTag leckfellsurfacesurvey.LargePotTag
LargePot.EntranceTag largetonorthendpotsurface.KevinDixonGPSBolt	1.08	-	DOWN	; LargePot.EntranceTag is RRCPC tag which seemed to be missing in 2013; KevinDixonGPSBolt is Kevin Dixon's 3C13 survey bolt, s/s bolt+washer in bedrock in Large Pot entrance, washer stamped LARGE POT 3C13; this leg connects the RRCPC tag with the Kevin Dixon bolt in order to tie in the 2013 surface survey from Large to North End Pot

*equate RiftPot.RiftTowardsMousehole.23 LargePot.Large15.23x

*include LittlePot/LittlePot
*equate LittlePot.EntranceTag leckfellsurfacesurvey.LargePotTag

*include Mohole/Mohole

*include ForgetMePot/ForgetMePot
*equate Mohole.Wall ForgetMePot.ForgetMePot1.1

*include KangoHole/KangoHole  


; Witches Cave and surrounding area (some entrances to be tied in with the rest of the surface survey)

*include WitchesCaveII/WitchesII 
*fix WitchesII.WitchesII-2.001 66214 79777 277 ;entrance GPS by K Wood Sept 2010

*include WitchesCave/WitchesCave
*fix WitchesCave.wit.001 66029.79 80004.53 214.77 
*equate WitchesCave.wit7.001 WitchesII.WitchesII-7.x

*include LeckBeckHead/LeckBeckHead
; *fix LeckBeckHead.001 65938.92 80003.18 212.01	; commented out by Becka 30.10.11 and replaced by equate to LeckBeckHeadWestEast surface survey
*equate LeckBeckHeadWestEast.10 LeckBeckHead.001

*include LeckBeckHead/LeckBeckHeadWestEast
*equate LeckBeckHeadWestEast.18 WitchesCave.Witches1DryCave.18

*include KirkPot/KirkPot

*include GetDownShep/Shep_Pot
;*fix Shep_Pot.getdownshep1.getdownshep1_6.20 67064 78046 372  ; TEMP - Becka, 27 Dec - this needs sorting with proper fix, this is apparently GPS to top of tallest scaff pole which was station 22 in the Shep_Pot_1 survey and I've tied it to the top station in the getdownshep1 survey but not clear where getdownshep1.6-20 actually is
;<<<< This has been commented out as a surface survey now connects Shep pot to Notts Pot GPS tag via PeriolousPot >>>>

*include Surface/PinocchioPot_Surface
*equate PinocchioPot_Surface.1.23	3cgps.3c15
*include PinocchioPot/PinocchioPot
*equate PinocchioPot.1.0 PinocchioPot_Surface.1.2

*FIX SurfaceAboveFrink 			67047 77521 400 ; Cordinates taken from survex and height from altimiter watch - calibrated from Lost John's GPS tag
*equate SurfaceAboveFrink SurfaceAboveTopOfFrink

*include NorthEndPot/NorthEndPotUnderground
*equate NorthEndPotUnderground.1-x largetonorthendpotsurface.1-18 	; needs finishing 

*include aaaTempLocationForFiles/WestKingsdaleDigTEMP1
*include aaaTempLocationForFiles/WestKingsdaleDigTEMP2

*include PerilousPot/PerilousPot 
*include Surface/NottsPot_to_ShepPot
*equate NottsPot_to_ShepPot.1.0 PerilousPot.PerilousPot1.1.0	;<<<< Connecting PerilousPot entrance to surface survey >>>>
*equate NottsPot_to_ShepPot.3.0 3cgps.3c15  			;<<<< This connects ShepPot to PerilousPot surface survey to the NottsPot GPS Tag >>>>
*equate NottsPot_to_ShepPot.2.9 Shep_Pot.getdownshep1.getdownshep1_6.20  	;<<<<Linking GetDownShep entrance to Perilous surface survey >>>>

*include CockamineCave/CockamineCave
*equate CockamineCave.CockamineCave1.1 BigMeanie.BigMeanie_1.2P

*include WeePot/WeePot



