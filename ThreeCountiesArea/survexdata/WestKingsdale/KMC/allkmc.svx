*begin allkmc

; KMC is a giant file including lots of individual survey files - needs to be split up
*include KMC

; surveys done by CUCC on pre-2013 expo survey practice weekend
*include valleyentrance_cucc
*include milkyway1

; surveys done by Becka from 2013 to resurvey the Valley Entrance area
*include milkyway2

*equate KMC.Roof_Tunnel.003 valleyentrance_cucc.15
*equate milkyway1.1 valleyentrance_cucc.1
*equate milkyway2.1 KMC.ValleyEnt.41

*end allkmc
