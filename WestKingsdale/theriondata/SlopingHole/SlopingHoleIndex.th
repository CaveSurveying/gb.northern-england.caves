encoding  utf-8

survey SlopingHoleIndex

input SlopingHole1/SlopingHole1.th
input SlopingHole2/SlopingHole2.th
input SlopingHole3/SlopingHole3.th


################ Plan Joins #################
####Scrap Joins####
###################

#join 5WaysEntSP3@5WaysEnt TongaSP1@Tonga
join SlopingHole1SP1@SlopingHole1 SlopingHole2SP1@SlopingHole2
join SlopingHole2SP1@SlopingHole2 SlopingHole3SP1@SlopingHole3


####Extended Elevation Joins####

join SlopingHole1SE1@SlopingHole1 SlopingHole2SE1@SlopingHole2
join SlopingHole2SE1@SlopingHole2 SlopingHole3SE1@SlopingHole3


####Line Joins####
##################
#join Line1@MyLeftFoot:0    Line1@Picnic:end #sample line join



###################### MAPS ####################

map SlopingHoleIndex -title "SlopingHolePlan"

  SlopingHole2Plan@SlopingHole2
  break
  SlopingHole1Plan@SlopingHole1
  SlopingHole3Plan@SlopingHole3 
  
  
endmap

 
 map SlopingHoleIndexME -title "Sloping Hole_Extended_Elevation"
 
 SlopingHole1ME@SlopingHole1
 SlopingHole2ME@SlopingHole2
 SlopingHole3ME@SlopingHole3
   
 endmap

################# Equates #####################
###############################################



 equate 1.8@SlopingHole1  95.0@SlopingHole2
 equate 95.4@SlopingHole2 1.0@SlopingHole3
  
endsurvey

