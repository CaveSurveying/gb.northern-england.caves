*infer exports on ;Ignore missing exported stations to enable old data to be processed until we have replaced it all

*begin allkmc
*export	KMC.Master_Cave.1 Roof_Tunnel.003 ;ValleyEnt.41

; KMC is a giant file including lots of individual survey files - needs to be split up (started to split this up: Footleg 17-03-2015)
*include KMC

;Roof Tunnel resurvey from Ray Duffy 1997
*include RoofTunnel.svx
*equate	Roof_Tunnel.054 KMC.Master_Cave.1

;Original Window Aven 1977 survey
*include WindowAven.svx
*equate	Roof_Tunnel.052 Window_Aven.B7a

;DCC MilkyWay series resurvey
*flags duplicate
*include MilkyWay.svx
*flags not duplicate
*include CarrotPassage.svx
*equate	Roof_Tunnel.017 Milky_Way.001
*equate Milky_Way.015 KMC.DCC_Chunnel.001
*equate Milky_Way.015 Carrot_Passage.14

;*equate	ValleyEntrance.0 Roof_Tunnel.002  ;Entrance stations equate (better equate used instead of this in MilkyWay)
*equate	Milkyway.32 milky_way.005  ;Better stations to equate at bend in small crawling section of milky way to align data after suspected blunder in old Roof Tunnel section from entrance

;Footleg's DistoX resurvey of Valley Entrance and Milkyway
*include ValleyEntrance-DistoX.svx
*include MilkyWay-DistoX.svx
*include RoofTunnel2.svx
*equate roof_tunnel.029 RoofTunnel2.4 ;Temporary tie in to R.Duffy Roof Tunnel centreline of floating section of resurvey until the gap can be covered again

;Toyland survey by Footleg (closes loop with Becka's milkyway2+3 data so included to confirm good loop but flagged as duplicate)
*include Toyland.svx

; surveys done by CUCC on pre-2013 expo survey practice weekend - probably don't use
;*include valleyentrance_cucc
;*include milkyway1
;*equate KMC.Roof_Tunnel.003 valleyentrance_cucc.15
;*equate milkyway1.1 valleyentrance_cucc.1

; surveys done by Becka from 2013 to resurvey the Valley Entrance area
*include milkyway2
*include milkyway3

*equate ValleyEntrance.27 MilkyWay.27
*equate MilkyWay.41 Toyland.13
*equate MilkyWay.41 milkyway2.1
*equate milkyway2.33 milkyway3.33x
*equate Toyland.4 milkyway3.9

*include RowtenPassage
*equate	KMC.Master_Cave.106 RowtenPassage.36
*equate	RowtenPassage.1 KMC.RowtenSumps.0
*equate	RowtenPassage.9 KMC.MudRiver.0

*include SwinstoSump
*equate	PhilosophersCrawl2.22 SwinstoSump.001
*equate	RowtenPassage.DistoXSumpTieIn.3 SwinstoSump.014

*include PhilosophersCrawl1
*include PhilosophersCrawl2
*equate	KMC.Master_Cave.106 PhilosophersCrawl2.15
*equate PhilosophersCrawl1.1 PhilosophersCrawl2.1

*end allkmc
