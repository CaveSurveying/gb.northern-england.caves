;created 14/7/15 by Noel Snape
;File containing only data that has been finalised for use in KMC - this should eventually replace all the old data


*begin KMC

*export ValleyEntrance.0
*export	PhilosophersCrawl2.15		;TEMPORARY measure until master cave is re-surveyed and tied in below


*include	ValleyEntrance			;Footleg's disto X survey
*include	MilkyWay				;Footlegs disto X survey
*include	milkyway2				;Becka's disto x survey
*include	milkyway3				;Becka's disto x survey
*include	RoofTunnel1				;Chris Williams and Shezi ULSA survey
*include	RoofTunnel2				;Chris Williams and Shezi ULSA survey
*include	PhilosophersCrawl2		;Footlegs dito x survey
*include	PhilosophersCrawl1		;Footleg's Suunto Tandem survey
*include	RowtenPassage			;Footleg's Suunto Tandem survey
*include	SwinstoSump				;John Cordingley's survey
*include	RowtenSumps				;CDG Derbyshire survey
*include	MudRiver				;Footleg's disto x survey
*include	milkyway4				;Brendan, Nathan, Jethro SUSS checc disto survey, 7th november
*include	milkyway_kellaway1		;Brendan, Nathan, Jethro SUSS checc disto survey, 8th november
*include	KingsdaleMC1			;Sarah Parker, Rachel Rix, Holly Bradley ULSA survey 08/03/2016
*include	KingsdaleMC2			;Luke Stangroom, Hannah Walker, Noel snape, ULSA survey 08/03/2016
*include	KingsdaleMC3			;Tom Starnes, Noel Snape, Holly Bradley 2016/03/20


*equate	ValleyEntrance.27	MilkyWay.27
*equate MilkyWay.41	milkyway2.1
*equate milkyway2.33	milkyway3.33x
*equate	RoofTunnel1.1	ValleyEntrance.27
*equate	RoofTunnel2.1	Rooftunnel1.16
*equate	PhilosophersCrawl2.1	PhilosophersCrawl1.1
*equate	RowtenPassage.36	PhilosophersCrawl2.15
*equate	SwinstoSump.001	PhilosophersCrawl2.22
*equate SwinstoSump.014	RowtenPassage.DistoXSumpTieIn.3
*equate	RowtenSumps.0	RowtenPassage.1
*equate	MudRiver.0	RowtenPassage.9
*equate milkyway2.10	milkyway4.0
*equate milkyway2.10 	milkyway_kellaway1.0 
*equate KingsdaleMC1.11	KingsdaleMC2.13
*equate KingsdaleMC2.15x	RowtenPassage.32
*equate	KingsdaleMC3.x1		KingsdaleMC1.x

*end KMC