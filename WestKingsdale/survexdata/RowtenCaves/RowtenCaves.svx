*begin Rowtencaves

*export rowtencave_surface.5hex
*export	jinglingcavetop.1

*include rowtencave_surface
*include rowtencavebottom
;*include rowtencavebottom2
*include Rowtencavemiddle
*include rowtencavetop2
*include rowtencavetop
*include jinglinginlet
*include jinglinginlet2
*include	jinglingmiddle
*include	jinglingcavetop2
*include jinglingcavetop

*equate rowtencavebottom.1	rowtencave_surface.1x
*equate rowtencavebottom.11	rowtencavemiddle.26
;*equate	Rowtencavemiddle.x20	rowtencavebottom2.17
*equate Rowtencavemiddle.x1	rowtencavetop2.25
*equate rowtencavetop.18	rowtencavetop2.18
*equate	Rowtencavemiddle.x11	jinglinginlet.J1
*equate	jinglinginlet.9	jinglinginlet2.x9
*equate	jinglinginlet2.5	jinglingmiddle.x5
*equate	jinglingcavetop2.20	jinglingmiddle.x20
*equate jinglingcavetop.9	jinglingcavetop2.9x



*end Rowtencaves