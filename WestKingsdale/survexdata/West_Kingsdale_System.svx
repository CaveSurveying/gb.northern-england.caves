*begin wks ;West_Kingsdale_System

*cs out OSGB:SD
*cs OSGB:SD

;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;This automatically applies correction for magnetic declination and grid north to all included surveys
*declination auto 67101  77807  373  ; Coordinates for Notts Pot
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

;*include KMC/allKMC
*include KMC/Old_KMC
*include KMC/KMC
*include Swinsto/Swinsto
*include RowtenCaves/RowtenCaves		
*include Yordas/Yordas_old				;old innacurate/incomplete survey - to be replaced
*include Yordas/Yordas1
*include GreenLaids/GreenLaids
*include Aquamole/Aquamole
*include UpstreamSumps/UpstreamSumps
*include kdgps
*include RowtenPot/RowtenPot
*include Keld_Head/Keld_Head
*include JinglingPot/JinglingPot
*include BullPot/BullPot
*include Aquamole/AquamolePot_Resurvey
; *include OldGPS/OldGPS		; added back in by Becka 15/5/2017 so Kail Pot shows up ; removed by Becka 17/09/18 as all.svx not compiling with this in

*equate Old_KMC.roof_tunnel.002	kdgps.vent
*equate KMC.ValleyEntrance.0	kdgps.vent
*equate	Aquamole.main.25 upstreamsumps.pt1.0
*equate KMC.PhilosophersCrawl2.15	Old_KMC.Master_Cave.106


*equate RowtenPot.Rowten_Projected.1	kdgps.tr		;basic projection only, needs re-surveying
*equate Rowtencaves.rowtencave_surface.5hex	kdgps.3c21
*equate	Rowtencaves.jinglingcavetop.1	kdgps.3c22	

*equate	Old_KMC.Master_Cave.1 Keld_Head.kh09.218

*equate JinglingPot.1.0   kdgps.3c22
*equate Bullpot.1.23	kdgps.3c23
*equate AquamolePot_Resurvey.1.0 kdgps.3c22
*equate	Aquamole.main.1 AquamolePot_Resurvey.1.5

*equate	kdgps.3c26	Yordas1.ext


;Temporary section for Window aven, until connected into main survey via roof tunnel re-survey

*include KMC/Window_Aven
*equate Window_Aven.B7a	Old_KMC.Roof_Tunnel.052

;-------------------------------------------------------------------------------------------
;<<<< Entrance coordinates from Northern Caves >>>>

;*INCLUDE ApprenticePot/ApprenticePot


;*solve



*end  wks ;West_Kingsdale_System
