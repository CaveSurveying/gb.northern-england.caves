encoding  utf-8

survey 5WaysIndex

input 5WaysEnt/5WaysEnt.th
input Tonga/Tonga.th
input MarmaladeIndex/MarmaladeIndex.th
input MyLeftFoot/MyLeftFoot.th
input Picnic/Picnic.th
input P5/P5.th
input P6-P7/P6-P7.th


################ Plan Joins #################
####Scrap Joins####
###################

join 5WaysEntSP3@5WaysEnt TongaSP1@Tonga
#join TongaSP3@Tonga MarmaladeSP1@Marmalade

####Extended Elevation Joins####
join 5WaysEntSE2@5WaysEnt                      TongaSE1@Tonga
join 5WaysEntSE1@5WaysEnt                      TongaSE1@Tonga
join TongaSE2@Tonga                            MarmaladeSE1@Marmalade.MarmaladeIndex
join MarmaladeSE1@Marmalade.MarmaladeIndex     MyLeftFootSE1@MyLeftFoot
join MyLeftFootSE1@MyLeftFoot                  PicnicSE1@Picnic
join PicnicSE1@Picnic                          P5SE1@P5
join P5SE1@P5                                  P6-P7SE1@P6-P7


####Line Joins####
##################
join Line1@MyLeftFoot:0    Line1@Picnic:end 
join Line2@MyLeftFoot:end  Line2@Picnic:0


###################### MAPS ####################

map 5WaysIndex -title "5WaysPlan"  
  
  5WaysEntPlan@5WaysEnt
  break
  TongaPlan@Tonga
  break
  MarmaladeIndexPlan@MarmaladeIndex
  break
  MyLeftFootPlan@MyLeftFoot
  break
  PicnicPlan@Picnic
  break
  P5Plan@P5
  P6-P7Plan@P6-P7
  
 endmap
 
 map 5WaysIndexME -title "5Ways_Extended_Elevation"
 
 5WaysEntME@5WaysEnt
 TongaME@Tonga
 MarmaladeIndexME@MarmaladeIndex
 MyLeftFootME@MyLeftFoot
 PicnicME@Picnic
 P5ME@P5
 P6-P7ME@P6-P7
 
 endmap

################# Equates #####################
###############################################



 equate 1.53@5WaysEnt  1.0@Tonga
 equate 1.20@Tonga     1.20@Marmalade.MarmaladeIndex
 equate 1.27@Marmalade.MarmaladeIndex 1.0@MyLeftFoot
 equate 1.5@MyLeftFoot 1.0@Picnic 
 equate 1.6@Picnic 1.0@P5
 equate 1.6@P5 1.0@P6-P7
 
 #equate 73.3@5WaysEnt #74.2@Tonga

 

endsurvey

