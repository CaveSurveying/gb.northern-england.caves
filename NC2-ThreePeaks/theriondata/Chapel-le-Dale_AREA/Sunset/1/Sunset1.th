encoding  utf-8
survey Sunset1

###Maps, a collection of scraps that make up the final map###
map plan -projection plan 
  SSL [-5 5 m] below
  break
  SSH
endmap

map SSL -projection plan
  S2
endmap

map SSH -projection plan
  S3
  break
  S1
  S4
  S5
  S6
  S7
  S8
  S9
endmap

map plan2 -projection plan
  S1
  S2
  S3
  S4
  S5
  S6
  S7
  S8
  S9
endmap

#map elev -projection extended 
 # "insert scrap names here"
#endmap


###Inputs th2 file for final drawing###
input "Sunset1.plan.th2"
#input "Sunset1.ee.th2"


