encoding  utf-8
survey BlackShiver4


###Maps, a collection of scraps that make up the final map###
map plan -projection plan 
  m2
  break
  m1 [-23 -15 m] below
endmap

map m1 -projection plan 
  S4
endmap

map m2 -projection plan
  S1
  S2
  S3
endmap

map plan2 -projection plan
  S1
  S2
  S3
  S4
endmap

#map elev -projection extended 
#  "insert scrap names here"
#endmap


###Inputs th2 file for final drawing###
input "BlackShiver4.plan.th2"
input "BlackShiver4.ee.th2"

equate 7 1

