encoding  utf-8

survey MarmaladeIndex

#####Declination Therion Automatic From Individual Survey Dates####


input Marmalade/Marmalade.th
input Marmalade2/Marmalade2.th
input BadgerPassage/BadgerPassage.th
input BadgerAven/BadgerAven.th



################ Plan Joins #################
####Scrap Joins####
###################

join   MarmaladeSP1@Marmalade    Marmalade2SP1@Marmalade2
join   MarmaladeSP1@Marmalade    Marmalade2SP2@Marmalade2
join   MarmaladeSP1@Marmalade    Marmalade2SP3@Marmalade2
join   MarmaladeSP1@Marmalade    BadgerPassageSP1@BadgerPassage
join   Marmalade2SP1@Marmalade2  BadgerPassageSP1@BadgerPassage 

####Extended Elevation Joins#### 
join   BadgerPassageSE1@BadgerPassage      BadgerAvenSE1@BadgerAven   



####Line Joins####
#join   Line1@StreamwayOfMerit:0     Line1@LeftInlet:end
#join   Line2@StreamwayOfMerit:end   Line2@RightInlet:0
#join   Line2@LeftInlet:0            Line1@RightInlet:end




###################### MAP ####################

map MarmaladeIndexPlan -title "Marmalade"
  
    MarmaladePlan@Marmalade
    Marmalade2Plan@Marmalade2
    BadgerPassage@BadgerPassage  
endmap

map MarmaladeIndexME -title "Marmalade Extended Elevation"
   MarmaladeME@Marmalade
   BadgerPassageME@BadgerPassage
   BadgerAvenME@BadgerAven  
endmap

################# Equates #####################
###############################################


centerline

equate     1.21@Marmalade      1.0@Marmalade2
equate     1.21@Marmalade      1.0@BadgerPassage
equate     1.11@BadgerPassage  1.4@BadgerAven

endcenterline

endsurvey

