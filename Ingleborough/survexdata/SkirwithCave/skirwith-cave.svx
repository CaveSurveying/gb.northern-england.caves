;Skirwith Cave

*begin skirwith-cave

*export skirwith-surface.1


*cs OSGB:SD
*cs out EPSG:27700

*fix skirwith-surface.1 70905 73799	252 ; taken from Google Earth and OS map for elevation as more precise than Becka's phone


*equate lower-skirwith-entrance skirwith-lower-entrance.2
*entrance lower-skirwith-entrance

*equate upper-skirwith-entrance skirwith-upper-entrance-1.1
*entrance upper-skirwith-entrance

*include skirwith-surface

*equate skirwith-surface.1 skirwith-lower-entrance.1
*include skirwith-lower-entrance

*equate skirwith-surface.6 skirwith-upper-entrance-1.1
*include skirwith-upper-entrance-1

*equate skirwith-upper-entrance-2.1 skirwith-upper-entrance-1.45
*include skirwith-upper-entrance-2

;*include skirwith_jgtslapdash
;*equate skirwith_jgtslapdash.skir4.33 skirwith-upper-entrance-1.j2ndcairn 
;*equate skirwith_jgtslapdash.skir4.0 skirwith-upper-entrance-1.19 
;*equate skirwith_jgtslapdash.skir5back.29 skirwith-upper-entrance-1.5

*end skirwith-cave
