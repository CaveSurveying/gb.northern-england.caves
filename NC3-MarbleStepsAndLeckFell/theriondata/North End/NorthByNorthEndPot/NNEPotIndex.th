encoding  utf-8

survey NNEPotIndex

input NNEPot1/NNEPot1.th
input NNEPot2/NNEPot2.th
input LleanBean1/LleanBean1.th
input LleanBean2/LleanBean2.th


################ Plan Joins #################
####Scrap Joins####
###################

join NNEPot2SP5@NNEPot2 LleanBean1SP1@LleanBean1

####ME Joins####
join NNEPot1SE1@NNEPot1       NNEPot2SE1@NNEPot2
join NNEPot2SE2@NNEPot2       LleanBean1SE1@LleanBean1
#join LleanBean1SE1@LleanBean1 LleanBean2SE1@LleanBean2



####Line Joins####
##################
join Line1@LleanBean1:0    Line1@LleanBean2:end 
join Line1@LleanBean1:end  Line1@LleanBean2:0
join Line2@LleanBean1:end  Line2@LleanBean2:0
join Line3@LleanBean1:0    Line3@LleanBean2:end



###################### MAPS ####################

  map NNEPotIndexPlan -title "NNEPotIndex"  
  
  NNEPot1Plan@NNEPot1 
  NNEPot2Plan@NNEPot2
  LleanBean1Plan@LleanBean1
  break
  LleanBean2Plan@LleanBean2 
  
  endmap
 
###############################################
 
 map NNEPotIndexME -title "NNEPotIndex"
 
 NNEPot1ME@NNEPot1
 NNEPot2ME@NNEPot2 
 LleanBean1ME@LleanBean1
 LleanBean2ME@LleanBean2
 
 endmap

################# Equates #####################
###############################################



 equate 1.5@NNEPot1    1.0@NNEPot2
 equate 105.13@NNEPot2 1.0@LleanBean1
 equate 1.4@LleanBean1 1.0@LleanBean2
 

 

endsurvey

