*begin HammerPot
*export hammerentrance.0

*cs out OSGB:SD 
*cs OSGB:SD
*declination auto 85184.063	69704.284	415.252

*fix EntranceTag	85184.063	69704.284	415.252
;gps coordinates taken from Cave Registry, Northern England, Fountains fell, ffgps.svx 
*equate hammerentrance.0 EntranceTag
*entrance hammerentrance.0

;Surveyors - George Breley, Rob Watson, Rebecca Lawson (RRCPC), Olly Hall (SUSS), Ian Peachey, Mike Butcher
;November 2017 - December 2018

*include hammerentrance
*include hammerstemple
*include hammersecondpitch
*include hammerfifthpitch
*include hammersidepassage1
*include hammersidepassage2
*include hammerfifthpitch2
*include sludgecrawl
*include hammeroutfell
*include hammerlastpitch
*include hammerdssump
*include hammerincline
*include hammerwaterbutt
*include hammerclimb
; *include hammerupstream ;first attempt at surveying upstream passage from incline junction with out fell master cave. Survey abandoned due to disto malfunction Superceded by hammerupstreamsump survey so now commented out by Becka 6 Apr 2019
*include hammerupstreamsump	;second go at surveying upstream passage from incline junction with out fell master cave
*include hammer-upstream-to-sludge

*equate hammerentrance.33 hammerstemple.33
*equate hammerstemple.64 hammersecondpitch.64
*equate hammersecondpitch.89 hammerfifthpitch.89
*equate hammersecondpitch.89 hammersidepassage1.89
*equate hammerfifthpitch.126 hammersidepassage2.126
*equate hammerfifthpitch.126 hammerfifthpitch2.126
*equate hammerfifthpitch2.161 sludgecrawl.161
*equate hammeroutfell.225 sludgecrawl.225
*equate hammeroutfell.249 hammerlastpitch.249
*equate hammerlastpitch.280 hammerdssump.280
*equate hammerincline.0 sludgecrawl.226
*equate hammerincline.35 hammerwaterbutt.0
*equate hammerlastpitch.280 hammerclimb.0
; *equate sludgecrawl.225 hammerupstream.0
*equate hammerincline.0 hammerupstreamsump.x
*equate hammerupstreamsump.10 hammer-upstream-to-sludge.0

*end HammerPot
