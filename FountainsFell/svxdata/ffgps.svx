*export	0002		;Gingling Hole
*export	0004		;Election Hole
*export	0006		;Gingling Wet Sink
*export	0007		;Gingling Wet Sink
*export	0008		;GWS - dry entrance
*export	0009		;GWS - dry entrance
*export	0010		;GWS - dry entrance
*export	0011		;Coates Cavern



