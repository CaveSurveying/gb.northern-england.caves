*begin Keld_Head

*export kh09.218 Ent

*fix Ent  69570.60   76578.46   252.81 ;Kevin Dixon precision GPS fix for peg belay, July 2012 - moved up a level by Becka 2026 for consistency with other Kevin Dixon equates
*entrance Ent
*equate Ent EntranceSeries.kh01.001

*equate	EntranceSeries.kh01.062 kh02.062
*equate	EntranceSeries.kh01.019	WoodingsPassage.kh10.wp001
*equate	kh02.064 WoodingsPassage.kh10c.wp066
*equate	kh02.073 MarbleStepsBranch.Rup1.001
*fix kh02.073 69295.90 76727.19 244.06 ;Fixed MSB junction to force correct depth due to loop closure errors pulling diving data above water level. Footleg 26 Jun. 2013

;Water level at Keld Head resurgence is 252.36m altitude.
;KMC dive line belay is 1.2m above water level in diving data, but dry survey in KMC puts this at 267.37m (13.8m too high!).
;Adding vertical adjustment to link between diving data and dry data makes things worse as the
;bug in loop corrections with diving data in Survex actually pulls the depth of the deepest part
;of the sump down by over 20m as it is. Adding an adjustment for the upstream end just makes this worse.

*begin EntranceSeries
	*export kh01.001 kh01.019 kh01.062

	;Cave:	Keld Head 
	;Entrance series-From entrance peg belay (0.45m above water level) going 
	;upstream in main passage, to 305.83m from base in Kingsdale Passage.
	;Including loops in entrance area and Easter Aven

	*include kh01.svx
	*include kh01a.svx
	*include kh01b.svx ;EasterAven
	*include kh12.svx
	*include kh16.svx

	*equate	kh01.029	kh01a.001
	*equate	kh01.010	kh01a.019
	*equate	kh01.029	EasterAven.001
	*equate	kh01.001	kh12.017
	*equate	kh01a.015	kh12.001
	*equate	kh12.012	kh16.001
	*equate	kh01.029	kh16.032
*end EntranceSeries

*begin WoodingsPassage
	*export kh10.wp001 kh10c.wp066

	*include kh10.svx
	*include kh10a.svx
	*include kh10b.svx
	*include kh10c.svx
	*include kh15.svx

	*equate	kh10.wp022	kh10a.wp022
	*equate	kh10a.wp036	kh10b.wp036
	*equate	kh10b.wp054	kh10c.wp054
	*equate	kh10c.wp066	kh15.001
*end WoodingsPassage

*begin MarbleStepsBranch
	*export Rup1.001

	*include msb01.svx
	*include kh11_op.svx
	*include msb03.svx
	*include msb04.svx
	*include msb05.svx
	*include msb06_tb.svx
	*include msb07.svx
	
	*equate osmoticpalpitator.1	Rup1.076
	*equate Rup1.099 JNC1.001
	*equate JNC1.018 JNC2.001
	*equate Rup1.086 JNC3.001
	*equate Rup1.012 TBR.G2.001
	*equate Rup1.079 TBR.TubularBore.pt3.068

	*equate JNC2.035 JNC4.035

*end MarbleStepsBranch

*include kh02.svx
*include kh02a.svx
*include kh02b.svx
*include kh02c.svx
*include kh02d.svx
*include kh02e.svx
*include kh03.svx
*include kh04.svx
*include kh05.svx
*include kh06.svx
*include kh06a.svx
*include kh07.svx
*include kh08.svx
*include kh09.svx
*include kh09a.svx
*include kh14.svx

*equate	kh02.081	kh02a.001
*equate	kh02.088	kh03.088
*equate	kh02a.036	kh02b.001
*equate	kh02a.032	kh02c.001

*equate	kh02b.007	kh04.134

*equate	kh02c.018	kh02d.001
*equate	kh02c.027	kh02e.001

*equate	kh02e.010	kh06a.006c

*equate	kh03.112	kh04.112

*equate	kh04.121	kh14.001
*equate	kh04.138	kh05.138

*equate	kh05.148	kh06.148

*equate	kh06.159	kh06a.001
*equate	kh06.159	kh07.159

*equate	kh06a.006c	kh02e.010

*equate	kh07.171	kh08.171

*equate	kh08.193	kh09.193

*equate	kh09.193	kh09a.193
*equate	kh09.201	kh09a.193d




*end  Keld_Head
