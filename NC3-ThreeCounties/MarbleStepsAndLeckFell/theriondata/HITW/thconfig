encoding  utf-8
source HITWIndex.th

select BlastedPassage.HITWIndex
select Dignitas.HITWIndex
select HITWEntShaft.HITWIndex
#select HITWGNSS.HITWIndex


#export map -proj plan -layout local -o Output/HITWIndex.pdf
##Produces a pdf map##

#export map -o Output/HITWIndex.kml

#export model -o Output/HITWIndex.kml


#export model -fmt survex -o Output/HITWIndex.3d
##Produces a Survex 3d centerline##

