;Cave:	Low Douk Cave - Masongill

*begin	LowDouk

*export EntranceTag
*export LowDouk-RiftConnection
*equate  LowDouk4.21 LowDouk-RiftConnection
*equate EntranceTag LowDouk1.s01
*EQUATE EntranceTag entrance
*ENTRANCE entrance


*include LowDouk1
*include LowDouk2
*include LowDouk3
*include LowDouk4
*include LowDouk5
*include LowDouk6
*include LowDouk7
*include LowDoukStreamway
*include LowDoukToSump
*include LowDoukLeftAtSteps
*include LowDoukBACrift

;--------------------------------------------------------------------

*equate LowDouk1.016 LowDouk2.022
*equate LowDouk3.001 LowDouk1.017
*equate LowDouk1.014 LowDoukStreamway.1
*equate LowDouk4.1 LowDoukStreamway.1
*equate LowDouk5.1 LowDouk2.010
*equate LowDouk6.20 LowDouk1.s01
*equate LowDoukStreamway.67 LowDoukToSump.67x
*equate LowDoukStreamway.67 LowDoukLeftAtSteps.67x
*equate LowDoukToSump.13 LowDoukLeftAtSteps.13x
;*equate LowDouk1.002 LowDouk7.2x
*equate LowDouk1.s01 LowDouk7.tag
*equate LowDoukBACrift.26x LowDoukToSump.26

*end	LowDouk
