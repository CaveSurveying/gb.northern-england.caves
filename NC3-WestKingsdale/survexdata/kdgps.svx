; Cave:		Kingsdale Geodetic GPS Survey
; Surveyors:	Kevin Dixon and Meg Stark
; Dates:	30 June 2013, 13 July 2013, 10 August 2013
; Instruments:	Leica Geosystems SR530 GPS, KD SAC Combi Compass+Clino, Disto D2
; SVX File:	Created 19 September 2013 by K.Dixon 

; Note that Mohole and Keld Head can be found in 
; NC3-MarbleStepsAndLeckFell/survexdata/Surface/marblesteps-leckfell-easegill-gps-kdixon-2012.svx

; Geodetic L1/L2 GPS post-processed using RTKlib open source software with IGS precise ephemerides and OS base station
; data at Giggleswick, Leeds and Richmond. 
; ETRS89 co-ordinates determined from double difference integer fixed baselines
; from Giggleswick. Quality checked with baselines computed from Leeds and Richmond.
; ETRS89 co-ordinates converted to OSGB36 and OND using OS online co-ordinate transformer.
; Standard deviations for positions are from RTKlib and do not include any component from the OS transformation.
; OS state that OSTN02 which determines OSGB36 easting and northing is error free
; OS further state that OSGM02 which determines the elevation has a standard error of 0.02m

; OSGB36 co-ordinates are for the OS 100km square SD 
; to obtain full length co-ordinates, add 300000 to Easting and 400000 to Northing

*begin	kdgps
*date 2013.07.01

*export vent	;valley entrance centre of drum outer edge, start of Footleg survey
*export 3c23	;Bull Pot stainless steel bolt and washer in bedrock
*export tb2	;presumed to the be the start of the Jingling Pot cave survey
*export 3c24	;Aquamole top centre of square section upright bar in bedrock near entrance
*export tr	;Rowten Pot tree root presumed to be start of Rowten Pot cave survey
*export	3c21	;Rowten Pot -3c21 is top centre of hex head bolt in bedrock between P hangers
*export 3c22	;Jingling pot, stainless steel bolt and washer in bedrock
*export 3c19	;Simpsons Pot cow tag drill hole, start of cave survey
*export 3c18	;Turbary Pot stainless steel bolt marker
*export 3c17	;Swinsto stainless steel bolt marker
*export 3c25	;King Pot stainless steel bolt marker at entrance
*export 3c26	;Yordas Pot drill hole marker at entrance 

; known magnetic azimuth of 328.0 at Bull Pot Farm
; observed compass bearing of 328.0 
; therefore zero magnetic error
; magnetic north 02 degrees 04 minutes west of grid north as per British Geological Survey online calculator for July 2013
; therefore zero correction term for survex is +2.067 degrees

;commented out by Simon Cornhill 2019.04.27 as it is superseded by *declination auto in West_Kingsdale_System.svx
;*calibrate compass +2.067 

*fix	3c17ae	69387.403	77533.612	380.458	;sdE 0.0011m, sdN 0.0006m, sdElev 0.017m
*fix	3c18ae	69505.327	77501.959	373.918	;sdE 0.0013m, sdN 0.0009m, sdElev 0.0024m
*fix	3c19ae	69619.341	77867.710	372.762	;sdE 0.0009m, sdN 0.0008m, sdElev 0.0016m
*fix	3c20ae	69907.233	77407.244	268.392	;sdE 0.0007m, sdN 0.0005m, sdElev 0.0013m
*fix	3c21ae	69821.522	78000.083	359.751	;sdE 0.0011m, sdN 0.0009m, sdElev 0.0021m
*fix	3c22ae	69894.817	78381.654	371.175	;sdE 0.0007m, sdN 0.0005m, sdElev 0.0013m
*fix	3c23ae	70214.196	78748.504	357.144	;sdE 0.0011m, sdN 0.0006m, sdElev 0.0020m
*fix	3c24ae	69927.791	78338.410	370.621	;sdE 0.0010m, sdN 0.0007m, sdElev 0.0015m
*fix	3c25ae	70788.934	77381.486	372.604	;sdE 0.0013m, sdN 0.0008m, sdElev 0.0018m
*fix	3c26ae	70575.072	79101.851	319.640	;sdE 0.0153m, sdN 0.0048m, sdElev 0.0162m

; Valley Entrance 30 June 2013
*flags surface
3c20ae	3c20gnd	1.292	-	DOWN	;3C20ae is GPS antenna base, 3C20gnd is top of rock outside entrance
3c20ae	vent	2.513	302.5	-24.5	;vent is centre of outer edge of drum
3c20ae	3c20	4.103	302.5	-23.0	;3c20 is stainless steel bolt and washer on right hand wall inside cave

; Bull Pot 30 June 2013
3c23ae	3c23	1.229	-	DOWN	;3c23ae is GPS antenna base, 3c23 is stainless steel bolt and washer in bedrock

; Jingling Pot 30 June 2013
*flags surface
3c22ae	3c22	1.267	-	DOWN	;3c22ae is GPS antenna base, 3c22 is stainless steel bolt and washer in bedrock
3c22	jp	7.094	106.0	-2.0	;jp is P hanger closest to trees on edge
jp	tb1	2.634	142.0	-1.0	;tb1 is base of eastern most tree
jp	tb2	2.279	142.0	-1.0	;tb2 is base of western most tree
; start of Jingling Pot cave survey is reportedly base of tree for direct hang, presumed to be one of the two trees above

; Aquamole 30 June 2013
3c24ae	3c24	1.132	-	DOWN	;3c24ae is GPS antenna base, 3c24 is top centre of square sectioned upright bar in bedrock

; Rowten Pot 13 July 2013

3c21ae	3c21	1.93	-	DOWN	;3c21ae is GPS antenna base, 3c21 is top centre of hex head bolt in bedrock between P hangers
3c21ae	tr	4.145	274.0	-42.0	;tr is tree root which is presumed to be start of Rowten Pot cave survey

; Simpsons Pot 13 July 2013
3c19ae	3c19	1.040	-	DOWN	;3c19ae is GPS antenna base, 3c19 is drill hole on rock lip above entrance which had cow tag

; Turbary Pot 13 July 2013
3c18ae	3c18	0.847	-	DOWN	;3c18ae is GPS antenna base, 3c18 is stainless steel bolt and washer in bedrock wall

; Swinsto Hole 13 July 2013
3c17ae	3c17	1.689	-	DOWN	;3c17ae is GPS antenna base, 3c17 is stainless steel bolt and washer is bedrock wall
; note empty drill hole 0.260m vertically above stainless steel bolt

; King Pot 10 August 2013
3c25ae	3c25	7.270	131.0	-35.0	;3c25ae is GPS antenna base, 3c25 is stainless steel bolt and washer in bedrock at entrance
3c25ae	3c25gnd	1.31	-	DOWN	;3c25gnd is fell ground level

;Yordas Pot 10 August 2013
3c26ae	yp1	8.572	241.5	-33.0	;3c26ae is GPS antenna base
yp1	yp2	11.662	242.0	-11.0	;yp1 and yp2 are intermediate points on rocks
yp2	3c26	11.340	265.0	-07.5	;3c26 is 8mm drill hole on right wall at narrowest part of cave entrance 0.16m below roof

*end	kdgps
