*begin westkingsdale ; West_Kingsdale_System

*cs OSGB:SD
*cs out EPSG:27700

;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
;This automatically applies correction for magnetic declination and grid north to all included surveys
*declination auto 67101  77807  373  ; Coordinates for Notts Pot
;+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

*include westkingsdale-gps-kdixon-2012 ; this file was called kdgps.svx renamed Becka May 26 for clarity

*include KMC/Old_KMC
*include KMC/KMC
*include UpstreamSumps/UpstreamSumps

*include Aquamole/Aquamole
*include BullPot/BullPot
*INCLUDE BuzzersPot/BuzzersPot
*include CraftsmansPot/CraftsmansPot-recon
*INCLUDE FagPot/FagPot
*include GreenLaids/GreenLaids
*include JinglingPot/JinglingPot
*INCLUDE KeldNookCave/KeldNookCave
*include Midas/Midas
*include RowtenCaves/RowtenCaves		
*include RowtenPot/RowtenPot
*INCLUDE SheepFoldPot/SheepFoldPot
*include SlantingCave/SlantingCave-recon
*include SlopingHole/SlopingHole 
*include Swinsto/Swinsto
*include TurbaryPot/TurbaryPot
*include Yordas/Yordas_old				;old innacurate/incomplete survey - to be replaced
*include Yordas/Yordas1

;+++++++++++++++
;Kingsdale Head
;+++++++++++++++
*INCLUDE BattyCave/BattyCave

; *include OldGPS/OldGPS		; no longer used


*equate Old_KMC.roof_tunnel.002	westkingsdale-gps-kdixon-2012.vent
*equate KMC.ValleyEntrance.0	westkingsdale-gps-kdixon-2012.vent

;*equate KMC.PhilosophersCrawl2.15	Old_KMC.Master_Cave.106		;removed 
*equate Old_KMC.Roof_Tunnel.052		KMC.KingsdaleMC1.1
*equate TurbaryPot.entrance westkingsdale-gps-kdixon-2012.3c18

*equate RowtenPot.Rowten_Projected.1	westkingsdale-gps-kdixon-2012.tr		;basic projection only, needs re-surveying
*equate Rowtencaves.rowtencave_surface.5hex	westkingsdale-gps-kdixon-2012.3c21
*equate	Rowtencaves.jinglingcavetop.1	westkingsdale-gps-kdixon-2012.3c22	

*equate JinglingPot.1.0   westkingsdale-gps-kdixon-2012.3c22

*equate Bullpot.1.23	westkingsdale-gps-kdixon-2012.3c23

*equate	 Aquamole.Aquamole3.4 upstreamsumps.pt1.0
*equate  Aquamole.Aquamole1.1.0 westkingsdale-gps-kdixon-2012.3c22

; 2026 Becka tied Swinsto entrance to the more accurate Kevin Dixon GPS but the fix in the Swinsto file may be better for the old DUSA survey
*equate Swinsto.Swi01.1 westkingsdale-gps-kdixon-2012.3c17 ;Swinsto Hole stainless steel bolt marker

*equate	Yordas1.ext westkingsdale-gps-kdixon-2012.3c26	


;Temporary section for Window aven, until connected into main survey via roof tunnel re-survey
*include KMC/Window_Aven
*equate Window_Aven.B7a	Old_KMC.Roof_Tunnel.052


;;;;;;;;;;;;;;;;;;;;;;;;;;;;
*SOLVE    	;This distributes the Valley Entrance/Keld Head loop closure errors along sump data only
			;and distributes the PhilosophersCraw/SwinstoSump loop closure errors along sump data only
*include Keld_Head/Keld_Head
*equate	Old_KMC.Master_Cave.1 Keld_Head.kh09.218
;Note the GPS location for Keld Head is within the main cave file and it says it uses the Kevin Dixon accurate GPS for this location

